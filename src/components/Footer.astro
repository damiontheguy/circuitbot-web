---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="divider"></div>
    <div class="footer-inner">
      <div class="footer-brand">
        <img src="/circuitbot.png" alt="CircuitBot" class="footer-logo-img" />
        <div>
          <div class="footer-name">CircuitBot</div>
          <div class="footer-tagline">Your game dev starting line.</div>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4>Product</h4>
          <a href="/create">Create Game</a>
          <a href="/pricing">Pricing</a>
          <a href="/my-games">My Games</a>
        </div>
        <div class="footer-col">
          <h4>Learn</h4>
          <a href="https://godotengine.org/download/" target="_blank" rel="noopener">Download Godot</a>
          <a href="https://docs.godotengine.org/en/stable/getting_started/introduction/index.html" target="_blank" rel="noopener">Godot Tutorials</a>
          <a href="/#how-it-works">How It Works</a>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} CircuitBot. All rights reserved.</span>
      <span class="footer-status">
        <span class="status-dot"></span>
        Describe it. Build on it. Make it yours.
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 48px 0 24px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding: 40px 0;
  }

  .footer-brand { display: flex; align-items: flex-start; gap: 12px; }

  .footer-logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .footer-tagline {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .footer-links { display: flex; gap: 56px; }

  .footer-col { display: flex; flex-direction: column; gap: 8px; }

  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .footer-col a {
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s;
    font-family: var(--font-sans);
  }
  .footer-col a:hover { color: var(--text-primary); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-muted);
    font-family: var(--font-sans);
  }

  .footer-status { display: flex; align-items: center; gap: 6px; }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 6px var(--accent-blue);
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; gap: 32px; }
    .footer-links { gap: 32px; flex-wrap: wrap; }
    .footer-bottom { flex-direction: column; gap: 8px; }
  }
</style>
