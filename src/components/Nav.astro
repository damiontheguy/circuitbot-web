---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/create', label: 'Create Game' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/my-games', label: 'My Games' },
  { href: '/download', label: 'Desktop App' },
];
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-brand">
      <span class="nav-logo-ring">
        <span class="nav-logo">CB</span>
      </span>
      <span class="nav-name">CircuitBot</span>
    </a>

    <div class="nav-links hide-mobile">
      {links.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-actions">
      <a href="/login" class="btn btn-ghost nav-login hide-mobile" id="nav-login-btn">Log in</a>
      <a href="#" class="btn btn-ghost nav-login hide-mobile" id="nav-logout-btn" style="display:none;">Log out</a>
      <a href="/create" class="btn btn-primary nav-cta">Create a Game</a>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav-mobile" id="nav-mobile">
    {links.map(link => (
      <a href={link.href} class="nav-mobile-link">{link.label}</a>
    ))}
    <a href="/login" class="nav-mobile-link">Log in</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 2px;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(6, 10, 6, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    height: var(--nav-height);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .nav-logo-ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
  }

  .nav-logo-ring::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1px solid var(--accent-green);
    opacity: 0.4;
    animation: ring-breathe 4s ease-in-out infinite;
  }

  @keyframes ring-breathe {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.05); }
  }

  .nav-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--bg-card);
    border: 1px solid var(--accent-green);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-green);
    text-shadow: 0 0 8px rgba(46, 204, 94, 0.5);
  }

  .nav-name {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--accent-green);
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 0 15px rgba(46, 204, 94, 0.3);
  }

  .nav-links { display: flex; gap: 2px; }

  .nav-link {
    padding: 6px 14px;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-secondary);
    transition: all 0.2s;
  }
  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
    text-shadow: none;
  }
  .nav-link.active {
    color: var(--accent-green);
    text-shadow: 0 0 8px rgba(46, 204, 94, 0.3);
  }

  .nav-actions { display: flex; align-items: center; gap: 8px; }
  .nav-login { font-size: 12px; padding: 6px 14px; }
  .nav-cta { font-size: 11px; padding: 8px 18px; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-toggle span {
    width: 18px;
    height: 1.5px;
    background: var(--accent-green);
    border-radius: 1px;
    transition: all 0.2s;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    padding: 16px 24px;
  }
  .nav-mobile.open { display: flex; }
  .nav-mobile-link {
    padding: 12px 0;
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
  }
  .nav-mobile-link:last-child { border-bottom: none; }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }
    .nav-cta { display: none; }
    .nav-login { display: none; }
    .nav-name { font-size: 14px; letter-spacing: 1.5px; }
  }

  @media (max-width: 360px) {
    .nav-name { font-size: 12px; letter-spacing: 1px; }
    .nav-logo-ring { width: 30px; height: 30px; }
    .nav-logo { width: 26px; height: 26px; font-size: 9px; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var toggle = document.getElementById('nav-toggle');
    var mobile = document.getElementById('nav-mobile');
    if (toggle && mobile) {
      toggle.addEventListener('click', function() { mobile.classList.toggle('open'); });
    }

    // Auth state
    var token = localStorage.getItem('token');
    var loginBtn = document.getElementById('nav-login-btn');
    var logoutBtn = document.getElementById('nav-logout-btn');
    if (token) {
      if (loginBtn) loginBtn.style.display = 'none';
      if (logoutBtn) logoutBtn.style.display = '';
      logoutBtn && logoutBtn.addEventListener('click', function(e) {
        e.preventDefault();
        localStorage.removeItem('token');
        window.location.href = '/';
      });
    }
  });
</script>
