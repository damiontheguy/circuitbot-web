---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Browse Games — CircuitBot" description="Play games built by the CircuitBot community. Explore AI-generated Godot 4 games created from text descriptions.">

  <section class="section browse-section">
    <div class="container">
      <div class="section-header">
        <h1 class="gradient-text">Browse Games</h1>
        <p class="section-sub">Play games built by the community.</p>
      </div>

      <div class="search-bar">
        <input type="text" id="search-input" class="search-input" placeholder="Search games or users..." autocomplete="off" />
      </div>

      <div class="sort-bar">
        <span class="sort-label">Sort by</span>
        <button class="sort-btn" data-sort="recent">Recent</button>
        <button class="sort-btn sort-active" data-sort="rating">Top Rated</button>
        <button class="sort-btn" data-sort="plays">Most Played</button>
      </div>

      <div id="browse-loading" class="state-msg">
        <div class="loader-ring"></div>
        <p>Loading games...</p>
      </div>

      <div id="browse-empty" class="state-msg" style="display:none;">
        <div class="empty-icon">&#127918;</div>
        <h2>No games yet</h2>
        <p>Be the first to build a game and share it with the community.</p>
        <a href="/create" class="btn btn-yellow btn-lg">Create a Game</a>
      </div>

      <div id="browse-grid" class="browse-grid" style="display:none;"></div>

      <div id="browse-load-more" style="display:none; text-align:center; margin-top:32px;">
        <button class="btn btn-primary" id="load-more-btn" type="button">Load More</button>
      </div>
    </div>
  </section>

</Layout>

<style>
  .browse-section {
    min-height: 70vh;
    padding-top: 3rem;
  }

  .section-sub {
    color: var(--text-muted);
    margin-top: 0.5rem;
    font-family: var(--font-sans);
  }

  .state-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 4rem 1rem;
    text-align: center;
    color: var(--text-muted);
  }

  .empty-icon {
    font-size: 3rem;
    line-height: 1;
  }

  .state-msg h2 {
    color: var(--text-primary);
    margin: 0;
  }

  .state-msg p {
    max-width: 28rem;
    line-height: 1.5;
  }

  .loader-ring {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .search-bar {
    max-width: 480px;
    margin: 0 auto 32px;
  }

  .search-input {
    width: 100%;
    padding: 12px 18px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }
  .search-input::placeholder {
    color: var(--text-muted);
  }
  .search-input:focus {
    border-color: var(--accent-blue);
  }

  .sort-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    justify-content: center;
  }
  .sort-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-right: 4px;
  }
  .sort-btn {
    padding: 6px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .sort-btn:hover {
    border-color: var(--accent-blue);
    color: var(--text-primary);
  }
  .sort-btn.sort-active {
    background: rgba(69, 130, 199, 0.12);
    border-color: var(--accent-blue);
    color: var(--accent-blue);
  }
  :global(.bc-play-count) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .browse-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  :global(.browse-card) {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  :global(.browse-card:hover) {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(69, 130, 199, 0.12);
  }

  :global(.bc-thumb-wrap) {
    aspect-ratio: 16 / 9;
    background: var(--bg-secondary);
    overflow: hidden;
  }
  :global(.bc-thumb) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  :global(.bc-thumb-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--text-muted);
  }

  :global(.bc-info) {
    padding: 14px 16px;
  }
  :global(.bc-title) {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  :global(.bc-prompt) {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 6px;
  }
  :global(.bc-meta) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  :global(.bc-creator) {
    font-size: 13px;
    color: var(--text-muted);
  }
  :global(.bc-rating) {
    font-size: 12px;
    color: var(--accent-yellow);
    white-space: nowrap;
  }

  :global(.browse-card-loading) {
    opacity: 0.7;
    cursor: default;
  }
  :global(.browse-card-loading:hover) {
    transform: none;
    box-shadow: none;
    border-color: var(--border);
  }

  :global(.bc-thumb-loading) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
  }

  :global(.bc-loading-inner) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  :global(.bc-spinner) {
    width: 28px;
    height: 28px;
    border: 3px solid var(--border);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: bc-spin 0.8s linear infinite;
  }

  @keyframes bc-spin {
    to { transform: rotate(360deg); }
  }

  :global(.bc-loading-text) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  :global(.bc-status-badge) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-yellow);
    white-space: nowrap;
  }
  :global(.bc-updating) {
    color: var(--accent-blue);
  }

  @media (max-width: 600px) {
    .browse-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function() {
    var API_BASE = window.location.hostname === 'localhost'
      ? 'http://localhost:8000'
      : 'https://circuitbot-api-production.up.railway.app';

    var LIMIT = 12;
    var offset = 0;
    var allLoaded = false;
    var currentQuery = '';
    var currentSort = 'rating';
    var searchTimer = null;

    var loading = document.getElementById('browse-loading');
    var empty = document.getElementById('browse-empty');
    var grid = document.getElementById('browse-grid');
    var loadMoreWrap = document.getElementById('browse-load-more');
    var loadMoreBtn = document.getElementById('load-more-btn');
    var searchInput = document.getElementById('search-input');

    // Pre-fill from URL ?q= param (e.g. from nav search)
    var urlParams = new URLSearchParams(window.location.search);
    var initialQ = urlParams.get('q');
    if (initialQ) {
      searchInput.value = initialQ;
      currentQuery = initialQ;
    }

    // Search with debounce
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function() {
        var q = searchInput.value.trim();
        if (q === currentQuery) return;
        currentQuery = q;
        offset = 0;
        allLoaded = false;
        grid.innerHTML = '';
        grid.style.display = 'none';
        empty.style.display = 'none';
        loadMoreWrap.style.display = 'none';
        loading.style.display = 'flex';
        loadGames();
      }, 300);
    });

    // Sort buttons
    document.querySelectorAll('.sort-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var s = btn.dataset.sort;
        if (s === currentSort) return;
        currentSort = s;
        document.querySelectorAll('.sort-btn').forEach(function(b) { b.classList.remove('sort-active'); });
        btn.classList.add('sort-active');
        offset = 0;
        allLoaded = false;
        grid.innerHTML = '';
        grid.style.display = 'none';
        empty.style.display = 'none';
        loadMoreWrap.style.display = 'none';
        loading.style.display = 'flex';
        loadGames();
      });
    });

    function loadGames() {
      if (allLoaded) return;

      var url = API_BASE + '/api/browse?limit=' + LIMIT + '&offset=' + offset + '&sort=' + currentSort;
      if (currentQuery) url += '&q=' + encodeURIComponent(currentQuery);
      fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(games) {
          loading.style.display = 'none';

          if (!games || !games.length) {
            if (offset === 0) {
              empty.style.display = 'flex';
            } else {
              allLoaded = true;
              loadMoreWrap.style.display = 'none';
            }
            return;
          }

          grid.style.display = 'grid';

          // Fetch thumbnails then render
          var thumbPromises = games.map(function(game) {
            if (!game.thumbnail_key) return Promise.resolve();
            return fetch(API_BASE + '/api/browse/' + game.id + '/thumbnail')
              .then(function(r) { return r.json(); })
              .then(function(d) { game._thumb = d.thumbnail_url; })
              .catch(function() {});
          });

          Promise.all(thumbPromises).then(function() {
            games.forEach(function(game) {
              var title = game.game_title || game.prompt;
              var creator = game.creator_username ? 'by ' + game.creator_username : '';
              var isInProgress = game.status !== 'completed';

              var card = document.createElement(isInProgress ? 'div' : 'a');
              if (!isInProgress) card.href = '/play?id=' + game.id;
              card.className = 'browse-card' + (isInProgress ? ' browse-card-loading' : '');

              var thumbHtml;
              if (isInProgress) {
                thumbHtml = '<div class="bc-thumb-wrap bc-thumb-loading">' +
                  '<div class="bc-loading-inner">' +
                    '<div class="bc-spinner"></div>' +
                    '<span class="bc-loading-text">Generating' + (game.progress_pct > 0 ? ' ' + game.progress_pct + '%' : '...') + '</span>' +
                  '</div>' +
                '</div>';
              } else if (game._thumb) {
                thumbHtml = '<div class="bc-thumb-wrap"><img src="' + game._thumb + '" alt="" class="bc-thumb" loading="lazy" /></div>';
              } else {
                thumbHtml = '<div class="bc-thumb-wrap"><div class="bc-thumb-placeholder">&#127918;</div></div>';
              }

              var ratingHtml = '';
              if (!isInProgress && game.rating_count > 0) {
                var stars = Math.round(game.rating_avg);
                ratingHtml = '<span class="bc-rating">' + '\u2605'.repeat(stars) + '\u2606'.repeat(5 - stars) + '</span>';
              }

              var statusHtml = isInProgress ? '<span class="bc-status-badge">Building...</span>'
                : game.has_active_edit ? '<span class="bc-status-badge bc-updating">Updating...</span>' : '';

              var playCountHtml = !isInProgress && game.play_count > 0
                ? '<span class="bc-play-count">' + game.play_count + ' play' + (game.play_count !== 1 ? 's' : '') + '</span>'
                : '';

              var promptText = game.prompt || '';
              var displayTitle = game.game_title || '';

              card.innerHTML = thumbHtml +
                '<div class="bc-info">' +
                  (displayTitle ? '<div class="bc-title">' + displayTitle.replace(/</g, '&lt;') + '</div>' : '') +
                  '<div class="bc-prompt">' + promptText.replace(/</g, '&lt;') + '</div>' +
                  '<div class="bc-meta">' +
                    (creator ? '<span class="bc-creator">' + creator.replace(/</g, '&lt;') + '</span>' : '<span></span>') +
                    (ratingHtml || statusHtml) +
                  '</div>' +
                  (playCountHtml ? '<div class="bc-meta" style="margin-top:2px;justify-content:flex-end;">' + playCountHtml + '</div>' : '') +
                '</div>';

              grid.appendChild(card);
            });

            offset += games.length;
            if (games.length < LIMIT) {
              allLoaded = true;
              loadMoreWrap.style.display = 'none';
            } else {
              loadMoreWrap.style.display = '';
            }
          });
        })
        .catch(function() {
          loading.style.display = 'none';
          if (offset === 0) {
            empty.style.display = 'flex';
          }
        });
    }

    loadMoreBtn.addEventListener('click', function() {
      loadMoreBtn.textContent = 'Loading...';
      loadGames();
      loadMoreBtn.textContent = 'Load More';
    });

    loadGames();
  })();
</script>
