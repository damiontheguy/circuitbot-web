---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Create Your Game — CircuitBot" description="Describe a game in plain language and get a playable executable in minutes.">

  <!-- Hero -->
  <section class="section create-hero">
    <div class="container">
      <div class="bg-grid"></div>
      <div class="section-header">
        <span class="badge badge-green">New Game</span>
        <h1 class="create-title">Create Your <span class="gradient-text">Game</span></h1>
        <p>Describe what you want to build. We handle the rest.</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Prompt Input -->
  <section class="section">
    <div class="container-narrow">
      <div class="prompt-wrapper">
        <div class="terminal">
          <div class="terminal-bar">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
            <span class="terminal-title">game prompt</span>
          </div>
          <div class="terminal-body prompt-body">
            <label for="game-prompt" class="prompt-label">// describe your game</label>
            <textarea
              id="game-prompt"
              class="prompt-textarea"
              placeholder="Describe the game you want to create. Be as specific as you'd like — genre, mechanics, art style, story..."
              rows="8"
            ></textarea>
          </div>
        </div>

        <!-- Example Chips -->
        <div class="chips-section">
          <p class="chips-label">Try an example:</p>
          <div class="chips-row">
            <button class="chip" data-prompt="A retro pixel-art roguelike dungeon crawler with procedural levels, permadeath, and loot drops">
              A retro pixel-art roguelike dungeon crawler
            </button>
            <button class="chip" data-prompt="A 2D platformer with a cute cat protagonist who collects fish and avoids dogs across colorful levels">
              A 2D platformer with a cute cat protagonist
            </button>
            <button class="chip" data-prompt="A tower defense game with medieval theme, upgradeable towers, and wave-based enemy progression">
              A tower defense game with medieval theme
            </button>
            <button class="chip" data-prompt="A space shooter with procedural enemy waves, power-ups, and a boss fight every 5 waves">
              A space shooter with procedural enemy waves
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Price + CTA -->
  <section class="section">
    <div class="container-narrow">
      <div class="price-card">
        <div class="price-amount">
          <span class="price-dollar">$</span>
          <span class="price-value">14.99</span>
        </div>
        <p class="price-subtitle">One game, fully generated</p>
        <ul class="price-includes">
          <li><span class="check">+</span> Complete Godot 4 project</li>
          <li><span class="check">+</span> AI-generated art assets</li>
          <li><span class="check">+</span> Compiled Windows executable</li>
          <li><span class="check">+</span> Source code included</li>
        </ul>
        <button id="generate-btn" class="btn btn-primary btn-lg generate-btn">
          Generate My Game — $14.99
        </button>

        <!-- Free Trial -->
        <div id="free-trial-section" class="free-trial-section" style="display: none;">
          <div class="free-trial-divider"><span>or</span></div>
          <button id="free-trial-btn" class="btn btn-secondary btn-lg free-trial-btn">
            Try Free — Verify Phone
          </button>
          <p class="free-trial-note">One free game per account. Phone verification required.</p>
        </div>

        <p class="disclaimer">
          By clicking generate, you agree to our <a href="/terms">Terms of Service</a>.
          Generation takes ~15-30 minutes.
        </p>
      </div>
    </div>
  </section>

  <!-- Phone Verification Modal -->
  <div id="phone-modal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <button class="modal-close" id="modal-close">&times;</button>
      <h2 class="modal-title">Verify Phone Number</h2>
      <p class="modal-sub">We'll text you a 6-digit code to verify your identity.</p>

      <!-- Step 1: Enter phone -->
      <div id="phone-step-1">
        <div class="form-group">
          <label for="phone-input" class="form-label">Phone Number</label>
          <input
            type="tel"
            id="phone-input"
            class="form-input"
            placeholder="+1 (555) 123-4567"
          />
        </div>
        <button id="send-code-btn" class="btn btn-primary modal-btn">Send Code</button>
      </div>

      <!-- Step 2: Enter code -->
      <div id="phone-step-2" style="display: none;">
        <p class="modal-phone-display">Code sent to <span id="modal-phone-display"></span></p>
        <div class="form-group">
          <label for="code-input" class="form-label">Verification Code</label>
          <input
            type="text"
            id="code-input"
            class="form-input code-input"
            placeholder="000000"
            maxlength="6"
            inputmode="numeric"
            pattern="[0-9]*"
          />
        </div>
        <button id="verify-code-btn" class="btn btn-primary modal-btn">Verify</button>
        <button id="resend-btn" class="btn-link">Resend code</button>
      </div>

      <p id="modal-error" class="modal-error" style="display: none;"></p>
    </div>
  </div>

  <!-- Error display -->
  <div id="error-toast" class="error-toast" style="display: none;"></div>

</Layout>

<script is:inline>
  var API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:8000'
    : 'https://circuitbot-api-production.up.railway.app';

  var _freeTrialEligible = false;
  var _phoneVerified = false;
  var _pendingPhone = '';

  // On load: check free trial eligibility
  (function checkTrialEligibility() {
    var token = localStorage.getItem('token');
    if (!token) return;

    fetch(API_BASE + '/api/auth/phone/status', {
      headers: { 'Authorization': 'Bearer ' + token },
    })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(data) {
      if (!data) return;
      _phoneVerified = data.phone_verified;
      _freeTrialEligible = data.free_trial_eligible;

      var section = document.getElementById('free-trial-section');
      var btn = document.getElementById('free-trial-btn');
      if (section && (_freeTrialEligible || !_phoneVerified)) {
        section.style.display = 'block';
      }
      if (btn && _freeTrialEligible) {
        btn.textContent = 'Generate Free';
      }
    })
    .catch(function() {});
  })();

  // Chip click -> fill textarea
  document.querySelectorAll('.chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      var textarea = document.getElementById('game-prompt');
      if (textarea) {
        textarea.value = chip.getAttribute('data-prompt') || chip.textContent.trim() || '';
        textarea.focus();
      }
      document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('chip-active'); });
      chip.classList.add('chip-active');
    });
  });

  // --- Paid Generate ---
  var genBtn = document.getElementById('generate-btn');
  if (genBtn) {
    genBtn.addEventListener('click', function() {
      startGeneration(false);
    });
  }

  // --- Free Trial ---
  var freeTrialBtn = document.getElementById('free-trial-btn');
  if (freeTrialBtn) {
    freeTrialBtn.addEventListener('click', function() {
      var token = localStorage.getItem('token');
      if (!token) {
        window.location.href = '/login?redirect=' + encodeURIComponent('/create');
        return;
      }
      if (!_phoneVerified) {
        openPhoneModal();
        return;
      }
      startGeneration(true);
    });
  }

  function startGeneration(isFreeTrial) {
    var textarea = document.getElementById('game-prompt');
    var prompt = textarea ? textarea.value.trim() : '';

    if (!prompt) {
      showError('Please describe the game you want to create.');
      if (textarea) textarea.focus();
      return;
    }

    var token = localStorage.getItem('token');
    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent('/create');
      return;
    }

    var activeBtn = isFreeTrial ? freeTrialBtn : genBtn;
    activeBtn.disabled = true;
    activeBtn.textContent = 'Creating job...';

    // Step 1: Create game job
    fetch(API_BASE + '/api/games', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify({ prompt: prompt }),
    })
    .then(function(jobRes) {
      if (!jobRes.ok) return jobRes.json().then(function(e) { throw new Error(e.detail || 'Failed to create game job'); });
      return jobRes.json();
    })
    .then(function(job) {
      if (isFreeTrial) {
        // Step 2a: Claim free trial
        return fetch(API_BASE + '/api/billing/free-trial', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
          },
          body: JSON.stringify({ game_job_id: job.id }),
        }).then(function(r) {
          if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Free trial failed'); });
          return r.json();
        }).then(function(result) {
          window.location.href = '/status?id=' + result.job_id;
        });
      } else {
        // Step 2b: Stripe checkout
        return fetch(API_BASE + '/api/billing/checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
          },
          body: JSON.stringify({ game_job_id: job.id }),
        }).then(function(checkoutRes) {
          if (!checkoutRes.ok) return checkoutRes.json().then(function(e) { throw new Error(e.detail || 'Failed to create checkout'); });
          return checkoutRes.json();
        }).then(function(checkout) {
          if (checkout.checkout_url) {
            window.location.href = checkout.checkout_url;
          } else {
            throw new Error('No checkout URL returned');
          }
        });
      }
    })
    .catch(function(err) {
      showError(err.message || 'Something went wrong. Please try again.');
      activeBtn.disabled = false;
      activeBtn.textContent = isFreeTrial ? 'Generate Free' : 'Generate My Game — $14.99';
    });
  }

  // --- Phone Verification Modal ---
  function openPhoneModal() {
    document.getElementById('phone-modal').style.display = 'flex';
    document.getElementById('phone-step-1').style.display = 'block';
    document.getElementById('phone-step-2').style.display = 'none';
    document.getElementById('modal-error').style.display = 'none';
  }

  function closePhoneModal() {
    document.getElementById('phone-modal').style.display = 'none';
  }

  document.getElementById('modal-close').addEventListener('click', closePhoneModal);
  document.getElementById('phone-modal').addEventListener('click', function(e) {
    if (e.target === this) closePhoneModal();
  });

  function showModalError(msg) {
    var el = document.getElementById('modal-error');
    el.textContent = msg;
    el.style.display = 'block';
  }

  function normalizePhone(raw) {
    var digits = raw.replace(/[^0-9+]/g, '');
    if (digits.length === 10) digits = '+1' + digits;
    if (!digits.startsWith('+')) digits = '+' + digits;
    return digits;
  }

  // Send code
  document.getElementById('send-code-btn').addEventListener('click', function() {
    var phoneRaw = document.getElementById('phone-input').value.trim();
    if (!phoneRaw) { showModalError('Enter your phone number.'); return; }
    var phone = normalizePhone(phoneRaw);
    _pendingPhone = phone;

    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Sending...';
    document.getElementById('modal-error').style.display = 'none';

    var token = localStorage.getItem('token');
    fetch(API_BASE + '/api/auth/phone/send-code', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify({ phone_number: phone }),
    })
    .then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Failed to send code'); });
      return r.json();
    })
    .then(function() {
      // Show step 2
      document.getElementById('phone-step-1').style.display = 'none';
      document.getElementById('phone-step-2').style.display = 'block';
      document.getElementById('modal-phone-display').textContent = phone;
      document.getElementById('code-input').focus();
    })
    .catch(function(err) {
      showModalError(err.message);
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Send Code';
    });
  });

  // Verify code
  document.getElementById('verify-code-btn').addEventListener('click', function() {
    var code = document.getElementById('code-input').value.trim();
    if (code.length !== 6) { showModalError('Enter the 6-digit code.'); return; }

    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Verifying...';
    document.getElementById('modal-error').style.display = 'none';

    var token = localStorage.getItem('token');
    fetch(API_BASE + '/api/auth/phone/verify', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify({ phone_number: _pendingPhone, code: code }),
    })
    .then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Verification failed'); });
      return r.json();
    })
    .then(function(data) {
      _phoneVerified = true;
      _freeTrialEligible = data.free_trial_eligible;
      closePhoneModal();
      // Update button state
      if (_freeTrialEligible && freeTrialBtn) {
        freeTrialBtn.textContent = 'Generate Free';
      }
      // Auto-trigger free generation
      startGeneration(true);
    })
    .catch(function(err) {
      showModalError(err.message);
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Verify';
    });
  });

  // Resend
  document.getElementById('resend-btn').addEventListener('click', function() {
    document.getElementById('phone-step-2').style.display = 'none';
    document.getElementById('phone-step-1').style.display = 'block';
    document.getElementById('modal-error').style.display = 'none';
  });

  function showError(msg) {
    var toast = document.getElementById('error-toast');
    if (toast) {
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(function() { toast.style.display = 'none'; }, 5000);
    }
  }
</script>

<style>
  /* ── Hero ────────────────────────── */
  .create-hero {
    position: relative;
    padding-bottom: 40px;
  }

  .create-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 0 30px rgba(46, 204, 94, 0.2);
    margin-bottom: 12px;
  }

  /* ── Prompt Area ────────────────── */
  .prompt-wrapper {
    max-width: 700px;
    margin: 0 auto;
  }

  .prompt-body {
    padding: 0 !important;
  }

  .prompt-label {
    display: block;
    padding: 16px 20px 8px;
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .prompt-textarea {
    display: block;
    width: 100%;
    min-height: 200px;
    padding: 8px 20px 20px;
    background: transparent;
    border: none;
    outline: none;
    resize: vertical;
    font-family: var(--font-code);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .prompt-textarea::placeholder {
    color: var(--text-muted);
  }

  .prompt-textarea:focus {
    background: rgba(46, 204, 94, 0.02);
  }

  /* ── Example Chips ──────────────── */
  .chips-section {
    margin-top: 20px;
  }

  .chips-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 8px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .chip:hover {
    border-color: var(--accent-green);
    color: var(--accent-green);
    box-shadow: var(--glow-green);
  }

  .chip-active {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    background: rgba(62, 235, 212, 0.06);
  }

  /* ── Price Card ─────────────────── */
  .price-card {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px 32px;
    box-shadow: var(--shadow-lg);
  }

  .price-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin-bottom: 4px;
  }

  .price-dollar {
    font-family: var(--font-mono);
    font-size: 24px;
    color: var(--text-muted);
  }

  .price-value {
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .price-subtitle {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
  }

  .price-includes {
    list-style: none;
    text-align: left;
    max-width: 300px;
    margin: 0 auto 28px;
  }

  .price-includes li {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
    padding: 4px 0;
  }

  .price-includes .check {
    color: var(--accent-green);
    margin-right: 8px;
    font-weight: 700;
  }

  .generate-btn {
    width: 100%;
    justify-content: center;
    font-size: 16px;
    padding: 16px 28px;
    margin-bottom: 16px;
  }

  .generate-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .disclaimer {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .disclaimer a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  /* ── Free Trial ──────────────────── */
  .free-trial-section {
    margin-top: 20px;
  }

  .free-trial-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .free-trial-divider::before,
  .free-trial-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .free-trial-btn {
    width: 100%;
    justify-content: center;
    font-size: 16px;
    padding: 16px 28px;
    background: transparent;
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .free-trial-btn:hover {
    background: rgba(62, 235, 212, 0.08);
    box-shadow: 0 0 20px rgba(62, 235, 212, 0.15);
  }

  .free-trial-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .free-trial-note {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 8px;
    font-family: var(--font-mono);
    letter-spacing: 0.3px;
  }

  /* ── Phone Modal ────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 24px;
  }

  .modal-card {
    width: 100%;
    max-width: 400px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px 28px;
    position: relative;
    box-shadow: var(--shadow-lg), 0 0 40px rgba(62, 235, 212, 0.1);
  }

  .modal-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-cyan), var(--accent-green), transparent);
  }

  .modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 24px;
    cursor: pointer;
    padding: 4px;
    line-height: 1;
  }

  .modal-close:hover {
    color: var(--text-primary);
  }

  .modal-title {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent-cyan);
    margin-bottom: 8px;
  }

  .modal-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .modal-btn {
    width: 100%;
    justify-content: center;
    margin-top: 8px;
    padding: 14px 24px;
  }

  .modal-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .modal-phone-display {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .code-input {
    text-align: center;
    font-size: 24px;
    letter-spacing: 8px;
    font-family: var(--font-mono);
  }

  .btn-link {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    margin-top: 12px;
    text-decoration: underline;
    display: block;
    text-align: center;
    width: 100%;
  }

  .btn-link:hover {
    color: var(--accent-cyan);
  }

  .modal-error {
    margin-top: 14px;
    padding: 10px 14px;
    background: rgba(239, 83, 80, 0.1);
    border: 1px solid rgba(239, 83, 80, 0.3);
    border-radius: var(--radius);
    color: var(--accent-red);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* ── Error Toast ────────────────── */
  .error-toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(239, 83, 80, 0.15);
    border: 1px solid var(--accent-red);
    color: var(--accent-red);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 12px 24px;
    border-radius: var(--radius);
    z-index: 1000;
    box-shadow: 0 0 20px rgba(239, 83, 80, 0.2);
  }

  /* ── Responsive ─────────────────── */
  @media (max-width: 600px) {
    .price-card {
      padding: 28px 20px;
    }

    .price-value {
      font-size: 44px;
    }

    .chip {
      font-size: 11px;
      padding: 6px 10px;
    }
  }
