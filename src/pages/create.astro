---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Create Your Game — CircuitBot | AI Game Generator" description="Describe a game in plain language and get a playable Godot 4 executable in 15-30 minutes. First game free, then $6.99 per game.">

  <!-- Hero -->
  <section class="section create-hero">
    <div class="container">
      <div class="bg-grid"></div>
      <div class="section-header">
        <span class="badge badge-blue">New Game</span>
        <h1 class="create-title">Create Your <span class="gradient-text">Game</span></h1>
        <p>Describe what you want to build. We handle the rest.</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Prompt Input -->
  <section class="section">
    <div class="container-narrow">
      <div class="prompt-wrapper">
        <div class="terminal">
          <div class="terminal-bar">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
            <span class="terminal-title">game prompt</span>
          </div>
          <div class="terminal-body prompt-body">
            <label for="game-prompt" class="prompt-label">// describe your game</label>
            <textarea
              id="game-prompt"
              class="prompt-textarea"
              placeholder="Describe the game you want to create. Be as specific as you'd like — genre, mechanics, art style, story..."
              rows="8"
            ></textarea>
          </div>
        </div>

        <!-- Generate Button (between textarea and chips) -->
        <div class="generate-row">
          <button id="generate-btn" class="btn btn-yellow generate-btn">
            Generate Game
          </button>
          <span class="generate-cost" id="generate-cost">~750 credits</span>
          <button id="free-trial-btn" class="btn btn-ghost generate-free-btn" style="display:none;">
            or Try Free
          </button>
        </div>

        <!-- Example Chips -->
        <div class="chips-section">
          <p class="chips-label">Try an example:</p>
          <div class="chips-row">
            <button class="chip" data-prompt="A retro pixel-art roguelike dungeon crawler with procedural levels, permadeath, and loot drops">
              A retro pixel-art roguelike dungeon crawler
            </button>
            <button class="chip" data-prompt="A 2D platformer with a cute cat protagonist who collects fish and avoids dogs across colorful levels">
              A 2D platformer with a cute cat protagonist
            </button>
            <button class="chip" data-prompt="A tower defense game with medieval theme, upgradeable towers, and wave-based enemy progression">
              A tower defense game with medieval theme
            </button>
            <button class="chip" data-prompt="A space shooter with procedural enemy waves, power-ups, and a boss fight every 5 waves">
              A space shooter with procedural enemy waves
            </button>
          </div>
        </div>
      </div>

      <!-- Active Generations -->
      <div id="active-jobs" class="active-jobs" style="display:none;">
        <div id="active-jobs-list" class="active-jobs-list"></div>
        <div id="completed-jobs-grid" class="active-jobs-grid"></div>
      </div>
    </div>
  </section>

  <!-- Phone Verification Modal -->
  <div id="phone-modal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <button class="modal-close" id="modal-close">&times;</button>
      <h2 class="modal-title">Verify Phone Number</h2>
      <p class="modal-sub">We will text you a 6-digit code to verify your identity.</p>

      <!-- Step 1: Enter phone -->
      <div id="phone-step-1">
        <div class="form-group">
          <label for="phone-input" class="form-label">Phone Number</label>
          <input
            type="tel"
            id="phone-input"
            class="form-input"
            placeholder="+1 (555) 123-4567"
          />
        </div>
        <button id="send-code-btn" class="btn btn-primary modal-btn">Send Code</button>
      </div>

      <!-- Step 2: Enter code -->
      <div id="phone-step-2" style="display: none;">
        <p class="modal-phone-display">Code sent to <span id="modal-phone-display"></span></p>
        <div class="form-group">
          <label for="code-input" class="form-label">Verification Code</label>
          <input
            type="text"
            id="code-input"
            class="form-input code-input"
            placeholder="000000"
            maxlength="6"
            inputmode="numeric"
            pattern="[0-9]*"
          />
        </div>
        <button id="verify-code-btn" class="btn btn-primary modal-btn">Verify</button>
        <button id="resend-btn" class="btn-link">Resend code</button>
      </div>

      <p id="modal-error" class="modal-error" style="display: none;"></p>
    </div>
  </div>

  <!-- Error display -->
  <div id="error-toast" class="error-toast" style="display: none;"></div>

</Layout>

<script is:inline>
  var API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:8000'
    : 'https://circuitbot-api-production.up.railway.app';

  var _freeTrialEligible = false;
  var _phoneVerified = false;
  var _pendingPhone = '';
  var _activeJobs = []; // tracked jobs on this page
  var _pollTimer = null;
  var MAX_JOBS = 5;

  var genBtn = document.getElementById('generate-btn');
  var freeTrialBtn = document.getElementById('free-trial-btn');
  var jobsContainer = document.getElementById('active-jobs');
  var jobsList = document.getElementById('active-jobs-list');
  var completedGrid = document.getElementById('completed-jobs-grid');

  // Fetch dynamic cost estimates
  fetch(API_BASE + '/api/browse/stats')
    .then(function(r) { return r.json(); })
    .then(function(stats) {
      var costEl = document.getElementById('generate-cost');
      if (costEl && stats.game_avg_credits) {
        costEl.textContent = '~' + stats.game_avg_credits.toLocaleString() + ' credits';
      }
    })
    .catch(function() {});

  // Check free trial eligibility
  (function() {
    var token = localStorage.getItem('token');
    if (!token) return;
    fetch(API_BASE + '/api/auth/phone/status', {
      headers: { 'Authorization': 'Bearer ' + token },
    })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(data) {
      if (!data) return;
      _phoneVerified = data.phone_verified;
      _freeTrialEligible = data.free_trial_eligible;
      if (freeTrialBtn && (_freeTrialEligible || !_phoneVerified)) {
        freeTrialBtn.style.display = '';
      }
      if (freeTrialBtn && _freeTrialEligible) {
        freeTrialBtn.textContent = 'or Generate Free';
      }
    })
    .catch(function() {});
  })();

  // Load existing in-progress jobs on page load
  (function loadExistingJobs() {
    var token = localStorage.getItem('token');
    if (!token) return;
    fetch(API_BASE + '/api/games', {
      headers: { 'Authorization': 'Bearer ' + token },
    })
    .then(function(r) { return r.ok ? r.json() : []; })
    .then(function(games) {
      // Show in-progress and recent completed games
      var relevant = games.filter(function(g) {
        return ['queued', 'generating', 'exporting', 'completed'].indexOf(g.status) !== -1;
      }).slice(0, MAX_JOBS);
      relevant.forEach(function(g) {
        addJobRow(g.id, g.prompt, g.status, g.progress_pct || 0, g.game_title, g.thumbnail_key);
      });
      if (_activeJobs.length > 0) startPolling();
      updateGenerateButton();
    })
    .catch(function() {});
  })();

  // Chip click -> fill textarea
  document.querySelectorAll('.chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      var textarea = document.getElementById('game-prompt');
      if (textarea) {
        textarea.value = chip.getAttribute('data-prompt') || chip.textContent.trim() || '';
        textarea.focus();
      }
      document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('chip-active'); });
      chip.classList.add('chip-active');
    });
  });

  genBtn.addEventListener('click', function() { startGeneration(false); });
  freeTrialBtn.addEventListener('click', function() {
    var token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/create'; return; }
    if (!_phoneVerified) { openPhoneModal(); return; }
    startGeneration(true);
  });

  function updateGenerateButton() {
    var inProgress = _activeJobs.filter(function(j) { return j.done === false; });
    if (inProgress.length >= MAX_JOBS) {
      genBtn.disabled = true;
      genBtn.textContent = 'Max 5 active';
    } else {
      genBtn.disabled = false;
      genBtn.textContent = 'Generate Game';
    }
  }

  function addJobRow(jobId, prompt, status, pct, gameTitle, thumbnailKey) {
    // Don't add duplicates
    if (_activeJobs.some(function(j) { return j.id === jobId; })) return;

    var done = status === 'completed' || status === 'failed';
    _activeJobs.push({ id: jobId, prompt: prompt, done: done });

    jobsContainer.style.display = '';

    if (status === 'completed') {
      renderCompletedCard(jobId, prompt, gameTitle, thumbnailKey);
    } else if (status === 'failed') {
      var row = document.createElement('div');
      row.className = 'job-row';
      row.id = 'job-' + jobId;
      var truncated = prompt.length > 60 ? prompt.substring(0, 57) + '...' : prompt;
      row.innerHTML =
        '<span class="job-prompt">' + truncated.replace(/</g, '&lt;') + '</span>' +
        '<span class="job-failed">Failed</span>';
      jobsList.appendChild(row);
    } else {
      var row = document.createElement('div');
      row.className = 'job-row';
      row.id = 'job-' + jobId;
      var truncated = prompt.length > 60 ? prompt.substring(0, 57) + '...' : prompt;
      row.innerHTML =
        '<span class="job-prompt">' + truncated.replace(/</g, '&lt;') + '</span>' +
        '<div class="job-progress"><div class="job-progress-fill" style="width:' + pct + '%"></div></div>' +
        '<span class="job-status">' + (status || 'queued') + '</span>';
      jobsList.appendChild(row);
    }
    updateGenerateButton();
  }

  function renderCompletedCard(jobId, prompt, gameTitle, thumbnailKey) {
    var card = document.createElement('a');
    card.href = '/play?id=' + jobId;
    card.className = 'job-card';
    card.id = 'job-' + jobId;

    var title = (gameTitle || prompt.substring(0, 40)).replace(/</g, '&lt;');
    card.innerHTML =
      '<img class="job-card-thumb" src="/circuitbot.png" alt="" />' +
      '<div class="job-card-body">' +
        '<span class="job-card-title">' + title + '</span>' +
        '<span class="job-card-play">Play &rarr;</span>' +
      '</div>';

    completedGrid.appendChild(card);

    // Load thumbnail async
    if (thumbnailKey) {
      var token = localStorage.getItem('token');
      fetch(API_BASE + '/api/games/' + jobId + '/thumbnail-url', {
        headers: { 'Authorization': 'Bearer ' + token },
      })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(data) {
        if (data && data.thumbnail_url) {
          var img = card.querySelector('.job-card-thumb');
          if (img) img.src = data.thumbnail_url;
        }
      })
      .catch(function() {});
    }
  }

  function updateJobRow(jobId, status, pct, gameTitle, thumbnailKey) {
    var row = document.getElementById('job-' + jobId);
    var job = _activeJobs.find(function(j) { return j.id === jobId; });

    if (status === 'completed') {
      if (job) job.done = true;
      if (row) row.remove(); // remove progress row
      renderCompletedCard(jobId, job ? job.prompt : '', gameTitle, thumbnailKey);
      updateGenerateButton();
    } else if (status === 'failed') {
      if (job) job.done = true;
      if (row) {
        var truncated = job ? (job.prompt.length > 60 ? job.prompt.substring(0, 57) + '...' : job.prompt) : '';
        row.innerHTML =
          '<span class="job-prompt">' + truncated.replace(/</g, '&lt;') + '</span>' +
          '<span class="job-failed">Failed</span>';
      }
      updateGenerateButton();
    } else if (row) {
      var fill = row.querySelector('.job-progress-fill');
      var statusEl = row.querySelector('.job-status');
      if (fill) fill.style.width = pct + '%';
      if (statusEl) statusEl.textContent = status;
    }
  }

  function startPolling() {
    if (_pollTimer) return;
    _pollTimer = setInterval(pollJobs, 8000);
  }

  function stopPolling() {
    if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
  }

  function pollJobs() {
    var token = localStorage.getItem('token');
    if (!token) return;
    var pending = _activeJobs.filter(function(j) { return !j.done; });
    if (pending.length === 0) { stopPolling(); return; }

    pending.forEach(function(j) {
      fetch(API_BASE + '/api/games/' + j.id, {
        headers: { 'Authorization': 'Bearer ' + token },
      })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(data) {
        if (data) updateJobRow(j.id, data.status, data.progress_pct || 0, data.game_title, data.thumbnail_key);
      })
      .catch(function() {});
    });
  }

  function startGeneration(isFreeTrial) {
    var textarea = document.getElementById('game-prompt');
    var prompt = textarea ? textarea.value.trim() : '';

    if (!prompt) {
      showError('Please describe the game you want to create.');
      if (textarea) textarea.focus();
      return;
    }

    var token = localStorage.getItem('token');
    if (!token) { window.location.href = '/login?redirect=/create'; return; }

    var activeBtn = isFreeTrial ? freeTrialBtn : genBtn;
    activeBtn.disabled = true;
    activeBtn.textContent = 'Creating...';

    fetch(API_BASE + '/api/games', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ prompt: prompt }),
    })
    .then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Failed'); });
      return r.json();
    })
    .then(function(job) {
      if (isFreeTrial) {
        return fetch(API_BASE + '/api/billing/free-trial', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ game_job_id: job.id }),
        }).then(function(r) {
          if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Free trial failed'); });
          return r.json();
        }).then(function() {
          addJobRow(job.id, prompt, 'queued', 0);
          textarea.value = '';
          startPolling();
        });
      } else {
        return fetch(API_BASE + '/api/billing/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ game_job_id: job.id }),
        }).then(function(r) {
          if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Checkout failed'); });
          return r.json();
        }).then(function(checkout) {
          if (checkout.checkout_url) window.location.href = checkout.checkout_url;
        });
      }
    })
    .catch(function(err) {
      showError(err.message);
    })
    .finally(function() {
      activeBtn.disabled = false;
      activeBtn.textContent = isFreeTrial ? 'or Generate Free' : 'Generate Game';
      updateGenerateButton();
    });
  }

  // --- Phone Verification Modal ---
  function openPhoneModal() {
    document.getElementById('phone-modal').style.display = 'flex';
    document.getElementById('phone-step-1').style.display = 'block';
    document.getElementById('phone-step-2').style.display = 'none';
    document.getElementById('modal-error').style.display = 'none';
  }

  function closePhoneModal() {
    document.getElementById('phone-modal').style.display = 'none';
  }

  document.getElementById('modal-close').addEventListener('click', closePhoneModal);
  document.getElementById('phone-modal').addEventListener('click', function(e) {
    if (e.target === this) closePhoneModal();
  });

  function showModalError(msg) {
    var el = document.getElementById('modal-error');
    el.textContent = msg;
    el.style.display = 'block';
  }

  function normalizePhone(raw) {
    var digits = raw.replace(/[^0-9+]/g, '');
    if (digits.length === 10) digits = '+1' + digits;
    if (!digits.startsWith('+')) digits = '+' + digits;
    return digits;
  }

  // Send code
  document.getElementById('send-code-btn').addEventListener('click', function() {
    var phoneRaw = document.getElementById('phone-input').value.trim();
    if (!phoneRaw) { showModalError('Enter your phone number.'); return; }
    var phone = normalizePhone(phoneRaw);
    _pendingPhone = phone;

    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Sending...';
    document.getElementById('modal-error').style.display = 'none';

    var token = localStorage.getItem('token');
    fetch(API_BASE + '/api/auth/phone/send-code', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify({ phone_number: phone }),
    })
    .then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Failed to send code'); });
      return r.json();
    })
    .then(function() {
      // Show step 2
      document.getElementById('phone-step-1').style.display = 'none';
      document.getElementById('phone-step-2').style.display = 'block';
      document.getElementById('modal-phone-display').textContent = phone;
      document.getElementById('code-input').focus();
    })
    .catch(function(err) {
      showModalError(err.message);
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Send Code';
    });
  });

  // Verify code
  document.getElementById('verify-code-btn').addEventListener('click', function() {
    var code = document.getElementById('code-input').value.trim();
    if (code.length !== 6) { showModalError('Enter the 6-digit code.'); return; }

    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Verifying...';
    document.getElementById('modal-error').style.display = 'none';

    var token = localStorage.getItem('token');
    fetch(API_BASE + '/api/auth/phone/verify', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + token,
      },
      body: JSON.stringify({ phone_number: _pendingPhone, code: code }),
    })
    .then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.detail || 'Verification failed'); });
      return r.json();
    })
    .then(function(data) {
      _phoneVerified = true;
      _freeTrialEligible = data.free_trial_eligible;
      closePhoneModal();
      // Update button state
      if (_freeTrialEligible && freeTrialBtn) {
        freeTrialBtn.textContent = 'Generate Free';
      }
      // Auto-trigger free generation
      startGeneration(true);
    })
    .catch(function(err) {
      showModalError(err.message);
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Verify';
    });
  });

  // Resend
  document.getElementById('resend-btn').addEventListener('click', function() {
    document.getElementById('phone-step-2').style.display = 'none';
    document.getElementById('phone-step-1').style.display = 'block';
    document.getElementById('modal-error').style.display = 'none';
  });

  function showError(msg) {
    var toast = document.getElementById('error-toast');
    if (toast) {
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(function() { toast.style.display = 'none'; }, 5000);
    }
  }
</script>

<style>
  /* ── Hero ────────────────────────── */
  .create-hero {
    position: relative;
    padding-bottom: 40px;
  }

  .create-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 0 30px rgba(69, 130, 199, 0.2);
    margin-bottom: 12px;
  }

  /* ── Prompt Area ────────────────── */
  .prompt-wrapper {
    max-width: 700px;
    margin: 0 auto;
  }

  .prompt-body {
    padding: 0 !important;
  }

  .prompt-label {
    display: block;
    padding: 16px 20px 8px;
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .prompt-textarea {
    display: block;
    width: 100%;
    min-height: 200px;
    padding: 8px 20px 20px;
    background: transparent;
    border: none;
    outline: none;
    resize: vertical;
    font-family: var(--font-code);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .prompt-textarea::placeholder {
    color: var(--text-muted);
  }

  .prompt-textarea:focus {
    background: rgba(69, 130, 199, 0.02);
  }

  /* ── Example Chips ──────────────── */
  .chips-section {
    margin-top: 20px;
  }

  .chips-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 8px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .chip:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    box-shadow: var(--glow-blue);
  }

  .chip-active {
    border-color: var(--accent-yellow);
    color: var(--accent-yellow);
    background: rgba(255, 211, 64, 0.06);
  }

  /* ── Generate Row ────────────────── */
  .generate-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .generate-btn {
    padding: 10px 24px;
    font-size: 14px;
  }

  .generate-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .generate-cost {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .generate-free-btn {
    font-size: 13px;
    padding: 8px 14px;
    color: var(--accent-yellow);
  }
  .generate-free-btn:hover {
    background: rgba(255, 211, 64, 0.08);
  }
  .generate-free-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  /* ── Active Generations ──────────── */
  .active-jobs {
    margin-top: 28px;
  }

  .active-jobs-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .active-jobs-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.job-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  :global(.job-prompt) {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  :global(.job-progress) {
    width: 80px;
    height: 4px;
    background: var(--bg-secondary);
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
  }

  :global(.job-progress-fill) {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-yellow));
    border-radius: 4px;
    transition: width 0.6s ease;
  }

  :global(.job-status) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    flex-shrink: 0;
