---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Documentation — CircuitBot">
  <section class="section doc-hero">
    <div class="container-narrow">
      <div class="section-header">
        <span class="badge badge-cyan">// DOCS</span>
        <h1 class="hero-title">Documentation</h1>
        <p class="hero-desc">Everything you need to get CircuitBot running with your Discord team and shipping code faster.</p>
      </div>
      <div class="scanline-bar"></div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Quick Start -->
  <section class="section">
    <div class="container-narrow">
      <h2 class="section-title"><span class="title-prefix">&gt;</span> Quick Start</h2>
      <p class="section-desc">Get from zero to your first AI-assisted commit in four steps.</p>

      <div class="steps">
        <div class="step">
          <div class="step-node">
            <span class="step-number">01</span>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <h3>Download CircuitBot</h3>
            <p>Grab the desktop app for your OS from the <a href="/download">download page</a>. Available for Windows, macOS, and Linux.</p>
          </div>
        </div>

        <div class="step">
          <div class="step-node">
            <span class="step-number">02</span>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <h3>Create a Discord Bot</h3>
            <p>Set up a bot application in the <a href="/docs/discord-bot">Discord Developer Portal</a> and copy its token. Takes about 5 minutes.</p>
          </div>
        </div>

        <div class="step">
          <div class="step-node">
            <span class="step-number">03</span>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <h3>Add Bot to Your Server</h3>
            <p>Generate an OAuth2 invite URL with the right permissions and add the bot to your Discord server.</p>
          </div>
        </div>

        <div class="step">
          <div class="step-node">
            <span class="step-number">04</span>
          </div>
          <div class="step-content">
            <h3>Start Coding</h3>
            <p>Launch the desktop app, complete the setup wizard, and <code>@mention</code> your bot in Discord to dispatch your first task.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Guides -->
  <section class="section">
    <div class="container-narrow">
      <h2 class="section-title"><span class="title-prefix">&gt;</span> Guides</h2>
      <p class="section-desc">In-depth walkthroughs to get you up and running.</p>

      <div class="grid grid-2 guide-grid">
        <a href="/docs/setup" class="guide-card">
          <div class="guide-card-header">
            <div class="guide-icon-wrap">
              <span class="guide-icon-text">[/]</span>
            </div>
            <span class="badge badge-green">10 min read</span>
          </div>
          <h3>Setup Guide</h3>
          <p>Install the desktop app, configure your account, connect your projects, and verify everything works.</p>
          <span class="guide-arrow">cd /docs/setup --&gt;</span>
        </a>

        <a href="/docs/discord-bot" class="guide-card">
          <div class="guide-card-header">
            <div class="guide-icon-wrap">
              <span class="guide-icon-text">[#]</span>
            </div>
            <span class="badge badge-cyan">5 min read</span>
          </div>
          <h3>Discord Bot Setup</h3>
          <p>Create a Discord bot application, configure intents and permissions, and invite it to your server.</p>
          <span class="guide-arrow">cd /docs/discord-bot --&gt;</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Reference -->
  <section class="section">
    <div class="container-narrow">
      <h2 class="section-title"><span class="title-prefix">&gt;</span> Reference</h2>
      <p class="section-desc">Detailed reference material for advanced configuration.</p>

      <div class="ref-links">
        <a href="#" class="ref-link">
          <div class="ref-link-icon">&lt;/&gt;</div>
          <div class="ref-link-inner">
            <h4>API Reference</h4>
            <p>Cloud API endpoints, authentication, and usage tracking.</p>
          </div>
          <span class="ref-link-arrow">--&gt;</span>
        </a>

        <a href="#" class="ref-link">
          <div class="ref-link-icon">{"{"}<span>*</span>{"}"}</div>
          <div class="ref-link-inner">
            <h4>Configuration</h4>
            <p>Model selection, spend caps, channel routing, and project settings.</p>
          </div>
          <span class="ref-link-arrow">--&gt;</span>
        </a>

        <a href="#" class="ref-link">
          <div class="ref-link-icon">[?]</div>
          <div class="ref-link-inner">
            <h4>Troubleshooting</h4>
            <p>Common issues, error messages, and how to resolve them.</p>
          </div>
          <span class="ref-link-arrow">--&gt;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────── */
  .doc-hero {
    padding-bottom: 40px;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: 52px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 16px;
    margin-bottom: 12px;
    color: var(--accent-green);
    text-shadow:
      0 0 10px rgba(46, 204, 94, 0.4),
      0 0 40px rgba(46, 204, 94, 0.15);
  }

  .hero-desc {
    font-size: 17px;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto;
    font-family: var(--font-sans);
  }

  .scanline-bar {
    margin-top: 32px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-green), transparent);
    opacity: 0.3;
  }

  /* ── Section titles ──────────────────────── */
  .section-title {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .title-prefix {
    color: var(--accent-green);
    text-shadow: 0 0 8px rgba(46, 204, 94, 0.5);
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 15px;
    margin-bottom: 32px;
    font-family: var(--font-sans);
  }

  /* ── Steps ───────────────────────────────── */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .step {
    display: flex;
    align-items: stretch;
    gap: 20px;
  }

  .step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 48px;
  }

  .step-number {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent-green);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--accent-green);
    background: rgba(46, 204, 94, 0.06);
    box-shadow: 0 0 12px rgba(46, 204, 94, 0.15), inset 0 0 12px rgba(46, 204, 94, 0.05);
    flex-shrink: 0;
  }

  .step-line {
    flex: 1;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-green), transparent);
    opacity: 0.25;
    margin: 4px 0;
    min-height: 20px;
  }

  .step-content {
    padding: 12px 20px 28px 0;
    flex: 1;
  }

  .step-content h3 {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
    color: var(--text-primary);
  }

  .step-content p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.7;
    font-family: var(--font-sans);
  }

  .step-content a {
    color: var(--accent-cyan);
  }

  .step-content code {
    font-family: var(--font-code);
    font-size: 13px;
    background: rgba(62, 235, 212, 0.08);
    border: 1px solid rgba(62, 235, 212, 0.15);
    padding: 2px 6px;
    border-radius: var(--radius);
    color: var(--accent-cyan);
  }

  /* ── Guide cards ─────────────────────────── */
  .guide-grid {
    gap: 20px;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
    overflow: hidden;
  }

  .guide-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-green), var(--accent-cyan));
    opacity: 0;
    transition: opacity 0.25s;
  }

  .guide-card:hover {
    border-color: var(--border-bright);
    box-shadow: var(--glow-green);
    transform: translateY(-2px);
    opacity: 1;
  }

  .guide-card:hover::before {
    opacity: 1;
  }

  .guide-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .guide-icon-wrap {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    background: var(--bg-secondary);
  }

  .guide-icon-text {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent-cyan);
  }

  .guide-card h3 {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .guide-card p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    flex: 1;
    font-family: var(--font-sans);
  }

  .guide-arrow {
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--text-muted);
    transition: color 0.25s;
  }

  .guide-card:hover .guide-arrow {
    color: var(--accent-green);
    text-shadow: 0 0 6px rgba(46, 204, 94, 0.4);
  }

  /* ── Reference links ─────────────────────── */
  .ref-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .ref-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: var(--bg-card);
    color: var(--text-primary);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    border-bottom: 1px solid var(--border);
  }

  .ref-link:last-child {
    border-bottom: none;
  }

  .ref-link:hover {
    background: var(--bg-hover);
    opacity: 1;
  }

  .ref-link-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent-green);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    background: var(--bg-secondary);
    flex-shrink: 0;
    transition: border-color 0.2s, color 0.2s, box-shadow 0.2s;
  }

  .ref-link:hover .ref-link-icon {
    border-color: var(--accent-green);
    box-shadow: 0 0 8px rgba(46, 204, 94, 0.2);
  }

  .ref-link-inner {
    flex: 1;
  }

  .ref-link h4 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .ref-link p {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  .ref-link-arrow {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
  }

  .ref-link:hover .ref-link-arrow {
    color: var(--accent-green);
    transform: translateX(4px);
  }

  /* ── Responsive ──────────────────────────── */
  @media (max-width: 600px) {
    .hero-title {
      font-size: 36px;
      letter-spacing: 1px;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }

    .step {
      gap: 14px;
    }

    .step-node {
      width: 40px;
    }

    .step-number {
      width: 36px;
      height: 36px;
      font-size: 12px;
    }
  }
</style>
