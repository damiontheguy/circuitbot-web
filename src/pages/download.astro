---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Desktop App — CircuitBot" description="CircuitBot desktop app — coming soon.">

  <section class="coming-soon-section">
    <div class="container">
      <div class="coming-soon-card">
        <div class="coming-soon-icon">
          <span class="icon-ring">
            <span class="icon-inner">&gt;_</span>
          </span>
        </div>

        <span class="badge badge-purple">Coming Soon</span>

        <h1 class="coming-soon-title">Desktop App</h1>

        <p class="coming-soon-desc">
          We're building a desktop app that lets you generate games locally
          with more control, custom templates, and offline project editing.
        </p>

        <div class="coming-soon-features">
          <div class="feature-item">
            <span class="feature-check">+</span>
            <span>Local game generation</span>
          </div>
          <div class="feature-item">
            <span class="feature-check">+</span>
            <span>Custom project templates</span>
          </div>
          <div class="feature-item">
            <span class="feature-check">+</span>
            <span>Built-in Godot project editor</span>
          </div>
          <div class="feature-item">
            <span class="feature-check">+</span>
            <span>Windows, macOS, and Linux</span>
          </div>
        </div>

        <p class="coming-soon-cta-text">In the meantime, generate games right from the browser:</p>

        <a href="/create" class="btn btn-primary btn-lg coming-soon-btn">Create a Game — $14.99</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .coming-soon-section {
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
  }

  .coming-soon-card {
    max-width: 520px;
    margin: 0 auto;
    padding: 48px 40px;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .coming-soon-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-purple), var(--accent-cyan), transparent);
  }

  .coming-soon-icon {
    margin-bottom: 20px;
  }

  .icon-ring {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--accent-purple);
    box-shadow: 0 0 20px rgba(123, 92, 191, 0.2);
    animation: ring-pulse 3s ease-in-out infinite;
  }

  @keyframes ring-pulse {
    0%, 100% { box-shadow: 0 0 15px rgba(123, 92, 191, 0.15); }
    50% { box-shadow: 0 0 25px rgba(123, 92, 191, 0.3); }
  }

  .icon-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(123, 92, 191, 0.3);
    background: rgba(123, 92, 191, 0.05);
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--accent-purple);
    text-shadow: 0 0 8px rgba(123, 92, 191, 0.5);
  }

  .coming-soon-title {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 16px 0 12px;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .coming-soon-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 28px;
    font-family: var(--font-sans);
  }

  .coming-soon-features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
    max-width: 300px;
    margin: 0 auto 32px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
  }

  .feature-check {
    color: var(--accent-purple);
    font-weight: 700;
    text-shadow: 0 0 4px rgba(123, 92, 191, 0.4);
  }

  .coming-soon-cta-text {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .coming-soon-btn {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .coming-soon-card {
      padding: 32px 20px;
    }
    .coming-soon-title {
      font-size: 28px;
    }
  }
</style>
