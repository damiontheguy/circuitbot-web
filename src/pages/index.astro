---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CircuitBot — AI Game Generator">

  <!-- Hero -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content">
        <span class="badge badge-green">AI Game Generator</span>
        <h1>
          <span class="gradient-text">Describe a Game.</span><br>
          <span class="gradient-text">Download an Executable.</span>
        </h1>
        <p class="hero-subtitle">
          Tell us what game you want in plain language. Our AI builds it with Godot 4
          — complete with art, code, and a compiled executable.
        </p>
        <div class="hero-buttons">
          <a href="/create" class="btn btn-primary btn-lg">Create Your First Game Free</a>
          <a href="#how-it-works" class="btn btn-lg">See How It Works</a>
        </div>
        <p class="hero-free-note">No credit card required. Your first game is on us.</p>
      </div>

      <div class="terminal hero-terminal">
        <div class="terminal-bar">
          <span class="terminal-dot red"></span>
          <span class="terminal-dot yellow"></span>
          <span class="terminal-dot green"></span>
          <span class="terminal-title">circuitbot — game generation</span>
        </div>
        <div class="terminal-body">
          <div class="term-line line-1">
            <span class="prompt">&gt; </span>
            <span class="cmd typewriter">A retro pixel-art roguelike dungeon crawler with procedural levels</span>
          </div>
          <div class="term-line line-2">
            <span class="output">Planning your game...</span>
          </div>
          <div class="term-line line-3">
            <span class="highlight">Generating pixel art assets...</span>
          </div>
          <div class="term-line line-4">
            <span class="highlight">Implementing 4 game systems...</span>
          </div>
          <div class="term-line line-5">
            <span class="output">Exporting executable...</span>
          </div>
          <div class="term-line line-6">
            <span class="success">&#10004; Your game is ready! Download now.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- How It Works -->
  <section class="section" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <h2 class="gradient-text">How It Works</h2>
      </div>
      <div class="grid grid-3">
        <div class="card step-card">
          <span class="step-number">01</span>
          <h3>Describe Your Game</h3>
          <p>Write a few sentences about the game you want. Genre, mechanics, art style — whatever you imagine.</p>
        </div>
        <div class="card step-card">
          <span class="step-number">02</span>
          <h3>We Build It</h3>
          <p>Our AI pipeline plans the architecture, generates art, writes GDScript, and compiles everything in Godot 4.</p>
        </div>
        <div class="card step-card">
          <span class="step-number">03</span>
          <h3>Download &amp; Play</h3>
          <p>Get a compiled Windows executable. Share it with friends, publish it, or use the Godot source to keep building.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- What You Get -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="gradient-text">What You Get</h2>
      </div>
      <div class="grid grid-3">
        <div class="card feature-card accent-green">
          <h3>2D &amp; 3D Art</h3>
          <p>AI-generated sprites, textures, and 3D models that match your game's visual style.</p>
        </div>
        <div class="card feature-card accent-cyan">
          <h3>Game Logic</h3>
          <p>Complete GDScript code — player movement, enemies, scoring, physics, and more.</p>
        </div>
        <div class="card feature-card accent-purple">
          <h3>UI Systems</h3>
          <p>Menus, HUD, health bars, score displays, and title screens.</p>
        </div>
        <div class="card feature-card accent-green">
          <h3>Scene Architecture</h3>
          <p>Properly structured Godot scenes with correct node hierarchies.</p>
        </div>
        <div class="card feature-card accent-cyan">
          <h3>Input Handling</h3>
          <p>Keyboard and controller mappings configured for your game's mechanics.</p>
        </div>
        <div class="card feature-card accent-purple">
          <h3>Compiled Executable</h3>
          <p>A ready-to-run Windows .exe. No Godot installation required to play.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Pricing -->
  <section class="section">
    <div class="container" style="text-align: center;">
      <div class="pricing-grid">
        <div class="card pricing-card pricing-free">
          <span class="pricing-badge">Free</span>
          <div class="pricing-amount">$0</div>
          <div class="pricing-label">first game</div>
          <ul class="pricing-features">
            <li>Full Godot 4 project</li>
            <li>AI-generated art assets</li>
            <li>Compiled Windows executable</li>
            <li>Just verify your phone number</li>
          </ul>
          <a href="/create" class="btn btn-primary btn-lg">Try It Free</a>
        </div>
        <div class="card pricing-card">
          <div class="pricing-amount">$14.99</div>
          <div class="pricing-label">per game after</div>
          <ul class="pricing-features">
            <li>Everything in free tier</li>
            <li>Unlimited games</li>
            <li>No restrictions on output</li>
            <li>Delivered in ~15-30 minutes</li>
          </ul>
          <a href="/create" class="btn btn-lg">Create a Game</a>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container-narrow">
      <div class="section-header">
        <h2 class="gradient-text">Frequently Asked Questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Is the first game really free?</summary>
          <p>Yes. Verify your phone number and generate one complete game at no cost. No credit card required. The free game includes everything — same quality, same output as paid games.</p>
        </details>
        <details class="faq-item">
          <summary>Why do I need to verify my phone?</summary>
          <p>Phone verification ensures one free game per person. It takes 30 seconds — we send a code, you enter it, and you're generating.</p>
        </details>
        <details class="faq-item">
          <summary>How long does generation take?</summary>
          <p>Most games are ready in 15-30 minutes, depending on complexity.</p>
        </details>
        <details class="faq-item">
          <summary>What engine is used?</summary>
          <p>Godot 4 — open source, no license fees. You get the full source project.</p>
        </details>
        <details class="faq-item">
          <summary>Can I edit the game after?</summary>
          <p>Yes! You receive the complete Godot project. Open it in Godot and modify anything.</p>
        </details>
        <details class="faq-item">
          <summary>What if generation fails?</summary>
          <p>If we can't produce a working game, you'll receive a full refund.</p>
        </details>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Final CTA -->
  <section class="section">
    <div class="container" style="text-align: center;">
      <h2 class="gradient-text cta-heading">Ready to build your game?</h2>
      <p class="cta-sub">Your first one's free. No credit card needed.</p>
      <a href="/create" class="btn btn-primary btn-lg" style="margin-top: 24px;">Create Your Free Game</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────────────── */
  .hero {
    padding-top: 80px;
    padding-bottom: 40px;
  }

  .hero-content {
    text-align: center;
    margin-bottom: 48px;
  }

  .hero h1 {
    font-size: clamp(28px, 5vw, 48px);
    line-height: 1.2;
    margin: 20px 0 16px;
    letter-spacing: 1.5px;
  }

  .hero-subtitle {
    font-size: clamp(15px, 2vw, 18px);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-free-note {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-cyan);
    letter-spacing: 0.3px;
  }

  .hero-terminal {
    max-width: 680px;
    margin: 0 auto;
  }

  /* ── Terminal typewriter animation ─────────── */
  .term-line {
    opacity: 0;
    visibility: hidden;
  }

  .line-1 { animation: appear 0.3s 0.5s forwards; }
  .line-2 { animation: appear 0.3s 1.8s forwards; }
  .line-3 { animation: appear 0.3s 2.8s forwards; }
  .line-4 { animation: appear 0.3s 3.8s forwards; }
  .line-5 { animation: appear 0.3s 4.8s forwards; }
  .line-6 { animation: appear 0.4s 5.8s forwards; }

  @keyframes appear {
    from { opacity: 0; visibility: visible; transform: translateY(4px); }
    to   { opacity: 1; visibility: visible; transform: translateY(0); }
  }

  .typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid var(--accent-green);
    width: 0;
    animation:
      typing 1.0s 0.5s steps(40) forwards,
      blink 0.6s 0.5s step-end 3;
  }

  @keyframes typing {
    from { width: 0; }
    to   { width: 100%; }
  }

  @keyframes blink {
    50% { border-color: transparent; }
  }

  /* ── Step cards ────────────────────────────── */
  .step-card {
    text-align: center;
    padding: 32px 24px;
  }

  .step-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 36px;
    color: var(--accent-green);
    text-shadow: 0 0 20px rgba(46, 204, 94, 0.3);
    margin-bottom: 16px;
  }

  .step-card h3 {
    font-family: var(--font-mono);
    font-size: 18px;
    margin-bottom: 12px;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .step-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ── Feature cards ─────────────────────────── */
  .feature-card {
    padding: 28px 24px;
    border-top: 2px solid transparent;
  }

  .feature-card.accent-green  { border-top-color: var(--accent-green); }
  .feature-card.accent-cyan   { border-top-color: var(--accent-cyan); }
  .feature-card.accent-purple { border-top-color: var(--accent-purple); }

  .feature-card h3 {
    font-family: var(--font-mono);
    font-size: 16px;
    margin-bottom: 10px;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .feature-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ── Pricing cards ─────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 720px;
    margin: 0 auto;
  }

  .pricing-card {
    text-align: center;
    padding: 40px 32px;
    position: relative;
  }

  .pricing-free {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 30px rgba(62, 235, 212, 0.1);
  }

  .pricing-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-cyan);
    color: var(--bg-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 4px 20px;
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .pricing-amount {
    font-family: var(--font-mono);
    font-size: 48px;
    color: var(--accent-green);
    text-shadow: 0 0 30px rgba(46, 204, 94, 0.3);
    line-height: 1;
    margin-top: 8px;
  }

  .pricing-free .pricing-amount {
    color: var(--accent-cyan);
    text-shadow: 0 0 30px rgba(62, 235, 212, 0.3);
  }

  .pricing-label {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 24px;
  }

  .pricing-features {
    list-style: none;
    margin-bottom: 28px;
    text-align: left;
  }

  .pricing-features li {
    font-size: 14px;
    color: var(--text-secondary);
    padding: 6px 0;
  }

  .pricing-features li::before {
    content: "\2713 ";
    color: var(--accent-green);
    margin-right: 8px;
  }

  .pricing-free .pricing-features li::before {
    color: var(--accent-cyan);
  }

  .pricing-card .btn {
    width: 100%;
    justify-content: center;
  }

  /* ── FAQ ────────────────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s;
  }

  .faq-item:hover,
  .faq-item[open] {
    border-color: var(--border-bright);
  }

  .faq-item summary {
    padding: 18px 24px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-primary);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: "+";
    font-size: 20px;
    color: var(--accent-green);
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 24px 18px;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ── Final CTA ─────────────────────────────── */
  .cta-heading {
    font-family: var(--font-mono);
    font-size: clamp(22px, 4vw, 32px);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cta-sub {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent-cyan);
    margin-top: 8px;
    letter-spacing: 0.3px;
  }

  /* ── Mobile adjustments ────────────────────── */
  @media (max-width: 600px) {
    .hero { padding-top: 48px; }
    .hero h1 { font-size: 24px; }
    .pricing-grid { grid-template-columns: 1fr; }
    .pricing-card { padding: 32px 24px; }
    .pricing-amount { font-size: 42px; }
  }
</style>
