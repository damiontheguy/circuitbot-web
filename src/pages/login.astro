---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Log In — CircuitBot" description="Log in to your CircuitBot account to create and manage AI-generated games." noindex={true}>

  <section class="login-section">
    <div class="login-wrapper">
      <div class="login-card">
        <!-- Logo -->
        <div class="login-logo">
          <img src="/circuitbot.png" alt="CircuitBot" class="login-logo-img" />
          <span class="logo-text"><span style="color: #4582c7;">CircuitBot</span></span>
        </div>

        <h1 class="login-heading">Log In</h1>
        <div class="login-sub">Access your account</div>

        <form id="login-form" action="#" method="POST">
          <div class="form-group" id="username-group" style="display:none;">
            <label for="username" class="form-label">Username</label>
            <input
              type="text"
              id="username"
              name="username"
              class="form-input"
              placeholder="Pick a username"
              autocomplete="username"
              minlength="3"
              maxlength="30"
              pattern="[a-zA-Z0-9_]+"
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            />
          </div>

          <div class="form-group form-check" id="mailing-list-group" style="display:none;">
            <label class="check-label">
              <input type="checkbox" id="mailing-list" name="mailing_list" />
              <span>Keep me updated on new features</span>
            </label>
          </div>

          <button type="submit" class="btn btn-primary login-btn">Log In</button>

          <a href="#" class="forgot-link">Forgot password?</a>
        </form>

        <div class="login-divider">
          <span class="login-divider-text">or</span>
        </div>

        <p class="signup-prompt">
          Do not have an account? <a href="#" id="signup-toggle">Sign up</a>
        </p>

        <p class="desktop-note">
          Or use the <a href="/download">desktop app</a>
        </p>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ──────────────────────────────── */
  .login-section {
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    position: relative;
  }

  .login-wrapper {
    width: 100%;
    max-width: 400px;
  }

  .login-card {
    padding: 40px 32px;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-blue), var(--accent-yellow), transparent);
  }

  /* ── Logo ────────────────────────────────── */
  .login-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .login-logo-img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 6px;
  }

  .logo-text {
    font-family: var(--font-mono);
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-primary);
  }

  /* ── Heading ─────────────────────────────── */
  .login-heading {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 6px;
    color: var(--accent-blue);
    text-shadow: 0 0 10px rgba(69, 130, 199, 0.3);
  }

  .login-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  /* ── Form ────────────────────────────────── */
  .form-group {
    margin-bottom: 18px;
    text-align: left;
  }

  .form-label {
    display: block;
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-family: var(--font-code);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input::placeholder {
    color: var(--text-muted);
    font-family: var(--font-code);
  }

  .form-input:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(69, 130, 199, 0.1), 0 0 12px rgba(69, 130, 199, 0.08);
  }

  .login-btn {
    width: 100%;
    justify-content: center;
    margin-top: 8px;
    padding: 14px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .form-check {
    margin-bottom: 8px;
  }

  .check-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: var(--font-sans);
  }

  .check-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--accent-blue);
    cursor: pointer;
  }

  .forgot-link {
    display: inline-block;
    margin-top: 14px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
  }

  .forgot-link:hover {
    color: var(--accent-yellow);
  }

  /* ── Divider ─────────────────────────────── */
  .login-divider {
    margin: 24px 0;
    height: 1px;
    background: var(--border);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-divider-text {
    background: var(--bg-card);
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  /* ── Footer links ────────────────────────── */
  .signup-prompt {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
    font-family: var(--font-sans);
  }

  .signup-prompt a {
    color: var(--accent-blue);
    font-weight: 600;
  }

  .desktop-note {
    font-size: 12px;
    color: var(--text-muted);
    font-family: var(--font-sans);
  }

  .desktop-note a {
    color: var(--accent-yellow);
  }

  /* ── Responsive ──────────────────────────── */
  @media (max-width: 480px) {
    .login-card {
      padding: 28px 20px;
    }

    .login-heading {
      font-size: 22px;
    }

    .login-logo-img {
      width: 48px;
      height: 48px;
    }
  }
</style>

<script is:inline>
  var API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:8000' : 'https://circuitbot-api-production.up.railway.app';

  var isSignup = false;

  function updateToggle() {
    var heading = document.querySelector('.login-heading');
    var sub = document.querySelector('.login-sub');
    var submitBtn = document.querySelector('#login-form button[type="submit"]');
    var signupPrompt = document.querySelector('.signup-prompt');

    var usernameGroup = document.getElementById('username-group');
    var usernameInput = document.getElementById('username');
    var mailingGroup = document.getElementById('mailing-list-group');
    if (usernameGroup) usernameGroup.style.display = isSignup ? '' : 'none';
    if (usernameInput) usernameInput.required = isSignup;
    if (mailingGroup) mailingGroup.style.display = isSignup ? '' : 'none';

    if (heading) heading.textContent = isSignup ? 'Sign Up' : 'Log In';
    if (sub) sub.textContent = isSignup ? 'Create your account' : 'Access your account';
    if (submitBtn) submitBtn.textContent = isSignup ? 'Sign Up' : 'Log In';
    if (signupPrompt) signupPrompt.innerHTML = isSignup
      ? 'Already have an account? <a href="#" id="signup-toggle">Log in</a>'
      : 'Don\'t have an account? <a href="#" id="signup-toggle">Sign up</a>';

    var newToggle = document.getElementById('signup-toggle');
    if (newToggle) {
      newToggle.addEventListener('click', function(e) {
        e.preventDefault();
        isSignup = !isSignup;
        updateToggle();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    var toggle = document.getElementById('signup-toggle');
    if (toggle) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        isSignup = !isSignup;
        updateToggle();
      });
    }

    var form = document.getElementById('login-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var emailEl = document.getElementById('email');
        var passEl = document.getElementById('password');
        var submitBtn = form.querySelector('button[type="submit"]');
        var email = emailEl ? emailEl.value : '';
        var password = passEl ? passEl.value : '';
        if (submitBtn) submitBtn.textContent = 'Loading...';

        var endpoint = isSignup ? '/api/auth/register' : '/api/auth/login';
        var payload = { email: email, password: password };
        if (isSignup) {
          var usernameVal = document.getElementById('username');
          var mailingCheckbox = document.getElementById('mailing-list');
          payload.username = usernameVal ? usernameVal.value.trim() : '';
          payload.wants_mailing_list = mailingCheckbox ? mailingCheckbox.checked : false;
        }
        fetch(API_BASE + endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        .then(function(resp) {
          if (!resp.ok) {
            return resp.json().then(function(err) {
              throw new Error(err.detail || 'Authentication failed');
            });
          }
          return resp.json();
        })
        .then(function(data) {
          localStorage.setItem('token', data.access_token);
          var params = new URLSearchParams(window.location.search);
          window.location.href = params.get('redirect') || '/create';
        })
        .catch(function(err) {
          alert(err.message || 'Something went wrong');
          if (submitBtn) submitBtn.textContent = isSignup ? 'Sign Up' : 'Log In';
        });
      });
    }
  });
</script>
