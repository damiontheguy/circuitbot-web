---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Log In — CircuitBot" description="Log in to your CircuitBot account.">

  <section class="login-section">
    <div class="login-wrapper">
      <div class="login-card">
        <!-- Logo -->
        <div class="login-logo">
          <div class="logo-ring">
            <div class="logo-ring-inner">
              <span class="logo-mark">&gt;_</span>
            </div>
          </div>
          <span class="logo-text">CircuitBot</span>
        </div>

        <h1 class="login-heading">Log In</h1>
        <div class="login-sub">Access your account</div>

        <form id="login-form" action="#" method="POST">
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit" class="btn btn-primary login-btn">Log In</button>

          <a href="#" class="forgot-link">Forgot password?</a>
        </form>

        <div class="login-divider">
          <span class="login-divider-text">or</span>
        </div>

        <p class="signup-prompt">
          Don't have an account? <a href="/pricing">Sign up</a>
        </p>

        <p class="desktop-note">
          Or log in through the <a href="/download">desktop app</a>
        </p>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout ──────────────────────────────── */
  .login-section {
    min-height: calc(100vh - var(--nav-height) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    position: relative;
  }

  .login-wrapper {
    width: 100%;
    max-width: 400px;
  }

  .login-card {
    padding: 40px 32px;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-green), var(--accent-cyan), transparent);
  }

  /* ── Logo ────────────────────────────────── */
  .login-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .logo-ring {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--accent-green);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 15px rgba(46, 204, 94, 0.2),
      inset 0 0 15px rgba(46, 204, 94, 0.05);
    animation: ring-pulse 3s ease-in-out infinite;
  }

  @keyframes ring-pulse {
    0%, 100% { box-shadow: 0 0 15px rgba(46, 204, 94, 0.2), inset 0 0 15px rgba(46, 204, 94, 0.05); }
    50% { box-shadow: 0 0 25px rgba(46, 204, 94, 0.35), inset 0 0 20px rgba(46, 204, 94, 0.08); }
  }

  .logo-ring-inner {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(46, 204, 94, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(46, 204, 94, 0.04);
  }

  .logo-mark {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--accent-green);
    text-shadow: 0 0 8px rgba(46, 204, 94, 0.5);
  }

  .logo-text {
    font-family: var(--font-mono);
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-primary);
  }

  /* ── Heading ─────────────────────────────── */
  .login-heading {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 6px;
    color: var(--accent-green);
    text-shadow: 0 0 10px rgba(46, 204, 94, 0.3);
  }

  .login-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  /* ── Form ────────────────────────────────── */
  .form-group {
    margin-bottom: 18px;
    text-align: left;
  }

  .form-label {
    display: block;
    font-size: 11px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-family: var(--font-code);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input::placeholder {
    color: var(--text-muted);
    font-family: var(--font-code);
  }

  .form-input:focus {
    border-color: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(46, 204, 94, 0.1), 0 0 12px rgba(46, 204, 94, 0.08);
  }

  .login-btn {
    width: 100%;
    justify-content: center;
    margin-top: 8px;
    padding: 14px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .forgot-link {
    display: inline-block;
    margin-top: 14px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
  }

  .forgot-link:hover {
    color: var(--accent-cyan);
  }

  /* ── Divider ─────────────────────────────── */
  .login-divider {
    margin: 24px 0;
    height: 1px;
    background: var(--border);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-divider-text {
    background: var(--bg-card);
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  /* ── Footer links ────────────────────────── */
  .signup-prompt {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
    font-family: var(--font-sans);
  }

  .signup-prompt a {
    color: var(--accent-green);
    font-weight: 600;
  }

  .desktop-note {
    font-size: 12px;
    color: var(--text-muted);
    font-family: var(--font-sans);
  }

  .desktop-note a {
    color: var(--accent-cyan);
  }

  /* ── Responsive ──────────────────────────── */
  @media (max-width: 480px) {
    .login-card {
      padding: 28px 20px;
    }

    .login-heading {
      font-size: 22px;
    }

    .logo-ring {
      width: 56px;
      height: 56px;
    }

    .logo-ring-inner {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  (function() {
    var form = document.getElementById('login-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        alert('Authentication is handled through the desktop app. Download CircuitBot at circuit-bot.com/download to log in.');
      });
    }
  })();
</script>
