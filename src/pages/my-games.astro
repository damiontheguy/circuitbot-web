---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My Games — CircuitBot" description="View and manage your AI-generated games. Track generation progress and download completed builds." noindex={true}>

  <section class="section games-section">
    <div class="container">
      <div class="section-header">
        <h1 class="gradient-text">My Games</h1>
        <p class="section-sub">Your generated games and their current status.</p>
      </div>

      <div id="games-container">
        <!-- Loading state -->
        <div id="games-loading" class="state-msg">
          <div class="loader-ring"></div>
          <p>Loading your games...</p>
        </div>

        <!-- Empty state (hidden by default) -->
        <div id="games-empty" class="state-msg" style="display:none;">
          <div class="empty-icon">&#9889;</div>
          <h2>No games yet</h2>
          <p>Create your first game and watch it come to life.</p>
          <a href="/create" class="btn btn-primary btn-lg">Create a Game</a>
        </div>

        <!-- Error state (hidden by default) -->
        <div id="games-error" class="state-msg" style="display:none;">
          <div class="empty-icon" style="color:var(--accent-red);">&#9888;</div>
          <h2>Something went wrong</h2>
          <p id="games-error-msg">Could not load your games.</p>
          <button class="btn btn-primary" onclick="loadGames()">Retry</button>
        </div>

        <!-- Game cards grid (hidden by default) -->
        <div id="games-grid" class="games-grid" style="display:none;"></div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .games-section {
    min-height: 70vh;
    padding-top: 3rem;
  }

  .section-sub {
    color: var(--text-muted, #888);
    margin-top: 0.5rem;
    font-family: var(--font-sans);
  }

  /* ---------- State messages ---------- */
  .state-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 4rem 1rem;
    text-align: center;
    color: var(--text-muted, #888);
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--accent-yellow);
    line-height: 1;
  }

  .state-msg h2 {
    color: var(--text-primary, #eee);
    margin: 0;
  }

  .state-msg p {
    max-width: 28rem;
    line-height: 1.5;
  }

  /* ---------- Loader ring ---------- */
  .loader-ring {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border, #333);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ---------- Games grid ---------- */
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 340px));
    justify-content: center;
    gap: 20px;
  }

  /* ---------- Game cards ---------- */
  .game-card {
    background: var(--bg-card, #2c2e2d);
    border: 1px solid var(--border, #353738);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .game-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 0 20px rgba(69, 130, 199, 0.08);
    transform: translateY(-2px);
  }

  /* ---------- Thumbnail ---------- */
  .game-card-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-secondary, #202125);
    overflow: hidden;
    position: relative;
  }

  .game-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .game-card-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted, #555);
    font-size: 2rem;
  }

  /* ---------- Card body ---------- */
  .game-card-body {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .game-card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #e0e0e0);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .game-card-prompt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted, #888);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  /* ---------- Badges row ---------- */
  .game-card-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  /* ---------- Status badges ---------- */
  .game-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    width: fit-content;
  }

  .badge-pending  { background: rgba(255, 211, 64, 0.12); color: var(--accent-yellow); border: 1px solid rgba(255, 211, 64, 0.25); }
  .badge-queued   { background: rgba(60, 83, 206, 0.12); color: var(--accent-deepblue); border: 1px solid rgba(60, 83, 206, 0.25); }
  .badge-active   { background: rgba(69, 130, 199, 0.12); color: var(--accent-blue); border: 1px solid rgba(69, 130, 199, 0.25); }
  .badge-complete { background: rgba(69, 130, 199, 0.12); color: var(--accent-blue); border: 1px solid rgba(69, 130, 199, 0.25); }
  .badge-failed   { background: rgba(255, 70, 70, 0.12); color: var(--accent-red); border: 1px solid rgba(255, 70, 70, 0.25); }

  .badge-pulse::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse-dot 1.4s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.7); }
  }

  /* Version & update badges */
  .badge-version {
    background: rgba(255, 211, 64, 0.1);
    color: var(--accent-yellow);
    border: 1px solid rgba(255, 211, 64, 0.2);
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .badge-updating {
    background: rgba(69, 130, 199, 0.1);
    color: var(--accent-blue);
    border: 1px solid rgba(69, 130, 199, 0.2);
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-weight: 600;
    animation: pulse-dot 1.4s ease-in-out infinite;
  }

  /* ---------- Progress bar (mini) ---------- */
  .mini-progress {
    width: 100%;
    height: 4px;
    background: var(--bg-secondary, #202125);
    border-radius: 4px;
    overflow: hidden;
  }

  .mini-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-yellow));
    border-radius: 4px;
    transition: width 0.6s ease;
  }

  /* ---------- Card footer ---------- */
  .game-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--border, #353738);
  }

  .game-date {
    font-size: 0.7rem;
    color: var(--text-muted, #888);
    font-family: var(--font-mono);
  }

  .game-arrow {
    color: var(--text-muted, #555);
    transition: color 0.2s, transform 0.2s;
  }

  .game-card:hover .game-arrow {
    color: var(--accent-blue);
    transform: translateX(3px);
  }

  /* ---------- Version history (expandable) ---------- */
  .version-toggle {
    display: block;
    width: 100%;
    padding: 0.5rem 1.25rem;
    background: none;
    border: none;
    border-top: 1px solid var(--border, #353738);
    color: var(--text-muted, #888);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    text-align: left;
    transition: color 0.2s;
  }

  .version-toggle:hover {
    color: var(--accent-yellow);
  }

  .version-history {
    border-top: 1px solid var(--border, #353738);
    padding: 0.75rem 1.25rem;
    background: var(--bg-secondary, #202125);
  }

  .version-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-secondary, #a8a3a3);
    border-bottom: 1px solid var(--border, #353738);
  }

  .version-item:last-child { border-bottom: none; }

  .version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .version-dot.completed { background: var(--accent-blue); }
  .version-dot.generating { background: var(--accent-yellow); }
  .version-dot.failed { background: var(--accent-red); }
  .version-dot.queued { background: var(--text-muted); }

  .version-desc {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .version-date {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: 0.65rem;
  }
</style>

<script is:inline>
  var API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:8000'
    : 'https://circuitbot-api-production.up.railway.app';

  var pollTimer = null;

  function getToken() {
    return localStorage.getItem('token');
  }

  function requireAuth() {
    var token = getToken();
    if (!token) {
      window.location.href = '/login?redirect=/my-games';
      throw new Error('Not authenticated');
    }
    return token;
  }

  // ── Status helpers ──────────────────────────
  var STATUS_MAP = {
    pending_payment: { label: 'Pending Payment', cls: 'badge-pending',  pulse: false },
    queued:          { label: 'Queued',           cls: 'badge-queued',   pulse: false },
    generating:      { label: 'Generating...',    cls: 'badge-active',   pulse: true  },
    exporting:       { label: 'Exporting...',     cls: 'badge-active',   pulse: true  },
    completed:       { label: 'Completed',        cls: 'badge-complete', pulse: false },
    failed:          { label: 'Failed',           cls: 'badge-failed',   pulse: false },
  };

  function truncate(text, max) {
    max = max || 100;
    return text.length > max ? text.slice(0, max) + '...' : text;
  }

  function formatDate(iso) {
    var d = new Date(iso);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function isInProgress(status) {
    return ['queued', 'generating', 'exporting'].includes(status);
  }

  // ── Render ──────────────────────────────────
  function renderCards(games) {
    var grid = document.getElementById('games-grid');
    grid.innerHTML = '';

    for (var i = 0; i < games.length; i++) {
      var game = games[i];
      var info = STATUS_MAP[game.status] || { label: game.status, cls: 'badge-queued', pulse: false };
      var progress = game.progress_pct || 0;
      var showProgress = isInProgress(game.status);
      var title = game.game_title || truncate(game.prompt, 40);

      var card = document.createElement('div');
      card.className = 'game-card';
      card.setAttribute('role', 'link');
      card.setAttribute('tabindex', '0');
      card.dataset.gameId = game.id;
      card.onclick = function(g) { return function(e) {
        // Don't navigate if clicking version toggle
        if (e.target.closest('.version-toggle') || e.target.closest('.version-history')) return;
        window.location.href = '/status?id=' + g.id;
      }; }(game);
      card.onkeydown = function(e) { if (e.key === 'Enter') this.click(); };

      var badgesHtml = '<span class="game-badge ' + info.cls + (info.pulse ? ' badge-pulse' : '') + '">' + info.label + '</span>';
      if (game.edit_count > 0) {
        badgesHtml += '<span class="badge-version">' + game.edit_count + ' update' + (game.edit_count !== 1 ? 's' : '') + '</span>';
      }
      if (game.has_active_edit) {
        badgesHtml += '<span class="badge-updating">Updating...</span>';
      }

      var thumbHtml = '<div class="game-card-thumb"><div class="game-card-thumb-placeholder">&#127918;</div><img data-game-id="' + game.id + '" alt="" /></div>';

      var historyToggle = '';
      if (game.edit_count > 0) {
        historyToggle = '<button class="version-toggle" data-game-id="' + game.id + '" onclick="toggleHistory(event, this)">View history (' + game.edit_count + ')</button>';
      }

      card.innerHTML = thumbHtml +
        '<div class="game-card-body">' +
          '<div class="game-card-badges">' + badgesHtml + '</div>' +
          '<h3 class="game-card-title">' + title + '</h3>' +
          '<p class="game-card-prompt">' + truncate(game.prompt, 80) + '</p>' +
          (showProgress ? '<div class="mini-progress"><div class="mini-progress-fill" style="width:' + progress + '%"></div></div>' : '') +
        '</div>' +
        '<div class="game-card-footer">' +
          '<span class="game-date">' + formatDate(game.created_at) + '</span>' +
          '<span class="game-arrow">&rarr;</span>' +
        '</div>' +
        historyToggle;

      grid.appendChild(card);

      // Load thumbnail async
      if (game.thumbnail_key) {
        loadThumbnail(game.id);
      }
    }
  }

  // ── Thumbnail loading ──────────────────────
  function loadThumbnail(gameId) {
    var token = getToken();
    if (!token) return;
    fetch(API_BASE + '/api/games/' + gameId + '/thumbnail-url', {
      headers: { Authorization: 'Bearer ' + token },
    })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(data) {
      if (data && data.thumbnail_url) {
        var img = document.querySelector('img[data-game-id="' + gameId + '"]');
        if (img) {
          img.src = data.thumbnail_url;
          img.style.display = 'block';
          // Hide placeholder
          var placeholder = img.previousElementSibling;
          if (placeholder) placeholder.style.display = 'none';
        }
      }
    })
    .catch(function() {});
  }

  // ── Version history toggle ─────────────────
  function toggleHistory(e, btn) {
    e.stopPropagation();
    var gameId = btn.dataset.gameId;
    var card = btn.closest('.game-card');
    var existing = card.querySelector('.version-history');

    if (existing) {
      existing.remove();
      btn.textContent = btn.textContent.replace('Hide', 'View');
      return;
    }

    var historyDiv = document.createElement('div');
    historyDiv.className = 'version-history';
    historyDiv.innerHTML = '<div style="color:var(--text-muted);font-size:0.75rem;font-family:var(--font-mono);">Loading...</div>';
    card.appendChild(historyDiv);
    btn.textContent = btn.textContent.replace('View', 'Hide');

    var token = getToken();
    fetch(API_BASE + '/api/games/' + gameId + '/versions', {
      headers: { Authorization: 'Bearer ' + token },
    })
    .then(function(r) { return r.ok ? r.json() : []; })
    .then(function(versions) {
      if (versions.length === 0) {
        historyDiv.innerHTML = '<div style="color:var(--text-muted);font-size:0.75rem;font-family:var(--font-mono);">No edits yet.</div>';
        return;
      }
      historyDiv.innerHTML = versions.map(function(v) {
        var dotCls = v.status === 'completed' ? 'completed' : (v.status === 'failed' ? 'failed' : (isInProgress(v.status) ? 'generating' : 'queued'));
        return '<div class="version-item">' +
          '<span class="version-dot ' + dotCls + '"></span>' +
          '<span class="version-desc">' + truncate(v.edit_instructions || 'Edit', 50) + '</span>' +
          '<span class="version-date">' + formatDate(v.created_at) + '</span>' +
        '</div>';
      }).join('');
    })
    .catch(function() {
      historyDiv.innerHTML = '<div style="color:var(--accent-red);font-size:0.75rem;">Failed to load history.</div>';
    });
  }

  // ── Data fetching ───────────────────────────
  function loadGames() {
    var token = requireAuth();

    var loading = document.getElementById('games-loading');
    var empty   = document.getElementById('games-empty');
    var error   = document.getElementById('games-error');
    var grid    = document.getElementById('games-grid');

    loading.style.display = 'flex';
    empty.style.display   = 'none';
    error.style.display   = 'none';
    grid.style.display    = 'none';

    fetch(API_BASE + '/api/games', {
      headers: { Authorization: 'Bearer ' + token },
    })
    .then(function(res) {
      if (!res.ok) {
        if (res.status === 401) {
          localStorage.removeItem('token');
          window.location.href = '/login?redirect=/my-games';
          return;
        }
        throw new Error('Server returned ' + res.status);
      }
      return res.json();
    })
    .then(function(games) {
      if (!games) return;
      loading.style.display = 'none';

      if (games.length === 0) {
        empty.style.display = 'flex';
        stopPolling();
        return;
      }

      renderCards(games);
      grid.style.display = 'grid';

      // Poll only when at least one job is active or has an active edit
      if (games.some(function(g) { return isInProgress(g.status) || g.has_active_edit; })) {
        startPolling();
      } else {
        stopPolling();
      }
    })
    .catch(function(err) {
      loading.style.display = 'none';
      error.style.display = 'flex';
      document.getElementById('games-error-msg').textContent = err.message || 'Could not load your games.';
      stopPolling();
    });
  }

  // ── Polling ─────────────────────────────────
  function startPolling() {
    if (pollTimer) return;
    pollTimer = setInterval(loadGames, 10000);
  }

  function stopPolling() {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  // ── Init ────────────────────────────────────
  document.addEventListener('DOMContentLoaded', loadGames);
  document.addEventListener('visibilitychange', function() {
    if (document.hidden) stopPolling();
  });
</script>
