---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pricing — CircuitBot | Credits for AI Game Generation" description="First game free. Buy credits to generate AI-powered Godot 4 games. Credits are deducted based on actual generation cost.">

  <!-- Hero -->
  <section class="section pricing-hero">
    <div class="container">
      <div class="bg-grid"></div>
      <div class="section-header">
        <span class="badge badge-blue">Pricing</span>
        <h1 class="pricing-title">Simple <span class="gradient-text">Pricing</span></h1>
        <p class="pricing-subtitle-text">First game free. Then buy credits to keep building.</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Pricing Cards -->
  <section class="section">
    <div class="container">
      <div class="pricing-card-grid pricing-card-grid-4">
        <!-- Free Tier -->
        <div class="pricing-card pricing-card-free">
          <div class="pricing-card-glow pricing-card-glow-yellow"></div>
          <div class="pricing-card-header">
            <span class="badge badge-yellow">Free Trial</span>
            <div class="pricing-amount">
              <span class="pricing-dollar pricing-dollar-yellow">$</span>
              <span class="pricing-value pricing-value-yellow">0</span>
            </div>
            <p class="pricing-label">first game</p>
          </div>

          <div class="pricing-divider"></div>

          <div class="pricing-includes">
            <p class="pricing-includes-label">// included</p>
            <ul class="pricing-features">
              <li><span class="feature-check feature-check-yellow">&#10003;</span> 1 full game generation</li>
              <li><span class="feature-check feature-check-yellow">&#10003;</span> Complete <span style="color: #4582c7;">Godot 4</span> project</li>
              <li><span class="feature-check feature-check-yellow">&#10003;</span> AI art + code + build</li>
              <li><span class="feature-check feature-check-yellow">&#10003;</span> Phone verification only</li>
            </ul>
          </div>

          <a href="/create" class="btn btn-primary btn-lg pricing-cta">Try Free</a>
          <p class="pricing-note">No credit card required</p>
        </div>

        <!-- Starter Pack -->
        <div class="pricing-card">
          <div class="pricing-card-glow"></div>
          <div class="pricing-card-header">
            <span class="badge badge-blue">Starter</span>
            <div class="pricing-amount">
              <span class="pricing-dollar">$</span>
              <span class="pricing-value">10</span>
            </div>
            <p class="pricing-label">1,000 credits</p>
          </div>

          <div class="pricing-divider"></div>

          <div class="pricing-includes">
            <p class="pricing-includes-label">// credits for</p>
            <ul class="pricing-features">
              <li><span class="feature-check">&#10003;</span> ~1-2 game generations</li>
              <li><span class="feature-check">&#10003;</span> Game edits &amp; iterations</li>
              <li><span class="feature-check">&#10003;</span> Credits never expire</li>
              <li><span class="feature-check">&#10003;</span> Pay only for what you use</li>
            </ul>
          </div>

          <button class="btn btn-primary btn-lg pricing-cta" data-pack="starter">Buy Credits</button>
          <p class="pricing-note">One-time purchase</p>
        </div>

        <!-- Standard Pack -->
        <div class="pricing-card pricing-card-popular">
          <div class="pricing-card-glow"></div>
          <div class="pricing-card-header">
            <span class="badge badge-yellow">Popular</span>
            <div class="pricing-amount">
              <span class="pricing-dollar">$</span>
              <span class="pricing-value">25</span>
            </div>
            <p class="pricing-label">2,500 credits</p>
          </div>

          <div class="pricing-divider"></div>

          <div class="pricing-includes">
            <p class="pricing-includes-label">// credits for</p>
            <ul class="pricing-features">
              <li><span class="feature-check">&#10003;</span> ~3-4 game generations</li>
              <li><span class="feature-check">&#10003;</span> Plenty of edits &amp; tweaks</li>
              <li><span class="feature-check">&#10003;</span> Credits never expire</li>
              <li><span class="feature-check">&#10003;</span> Best value for builders</li>
            </ul>
          </div>

          <button class="btn btn-yellow btn-lg pricing-cta" data-pack="standard">Buy Credits</button>
          <p class="pricing-note">Most popular choice</p>
        </div>

        <!-- Pro Pack -->
        <div class="pricing-card">
          <div class="pricing-card-glow"></div>
          <div class="pricing-card-header">
            <span class="badge badge-blue">Pro</span>
            <div class="pricing-amount">
              <span class="pricing-dollar">$</span>
              <span class="pricing-value">50</span>
            </div>
            <p class="pricing-label">5,000 credits</p>
          </div>

          <div class="pricing-divider"></div>

          <div class="pricing-includes">
            <p class="pricing-includes-label">// credits for</p>
            <ul class="pricing-features">
              <li><span class="feature-check">&#10003;</span> ~7-8 game generations</li>
              <li><span class="feature-check">&#10003;</span> Unlimited edits</li>
              <li><span class="feature-check">&#10003;</span> Credits never expire</li>
              <li><span class="feature-check">&#10003;</span> Best per-credit value</li>
            </ul>
          </div>

          <button class="btn btn-primary btn-lg pricing-cta" data-pack="pro">Buy Credits</button>
          <p class="pricing-note">For serious builders</p>
        </div>
      </div>

      <p class="credits-explainer">Credits are deducted based on actual generation cost. Average game costs ~600-900 credits. Edits cost ~200-400 credits.</p>
    </div>
  </section>

  <hr class="divider" />

  <!-- What's Included -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Deliverables</span>
        <h2>What Is <span class="gradient-text">Included</span></h2>
        <p>Every generated game ships with these three pillars.</p>
      </div>

      <div class="grid grid-3">
        <div class="card included-card">
          <div class="included-icon">&#127912;</div>
          <h3 class="included-title">AI Art Generation</h3>
          <p class="included-desc">
            Sprites, textures, tilesets, and backgrounds — all generated to match
            your game's style. No placeholder art.
          </p>
        </div>
        <div class="card included-card">
          <div class="included-icon">&#9000;</div>
          <h3 class="included-title">Game Logic</h3>
          <p class="included-desc">
            Complete <span style="color: #4582c7;">GDScript</span> code for all mechanics you described — movement,
            combat, UI, menus, scoring, and game state.
          </p>
        </div>
        <div class="card included-card">
          <div class="included-icon">&#9654;</div>
          <h3 class="included-title">Compiled Build</h3>
          <p class="included-desc">
            A Windows .exe ready to play, plus the full <span style="color: #4582c7;">Godot</span> project so you can
            open it in the editor and keep building.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- FAQ -->
  <section class="section">
    <div class="container-narrow">
      <div class="section-header">
        <span class="badge badge-yellow">FAQ</span>
        <h2>Common <span class="gradient-text">Questions</span></h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">Is the first game really free?</summary>
          <p class="faq-answer">
            Yes, completely free. Create an account, verify your phone number, and
            generate one full game at no cost. No credit card needed. Same quality
            and features as paid games.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Is it a subscription?</summary>
          <p class="faq-answer">
            No. You buy credit packs and spend them on game generations. There are
            no recurring charges, no monthly fees. Credits never expire — use them
            whenever you want.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Can I get a refund?</summary>
          <p class="faq-answer">
            If generation fails or produces something fundamentally broken, yes.
            Contact us and we will make it right. We stand behind the quality of
            every generated game.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How many games can I create?</summary>
          <p class="faq-answer">
            As many as you want. Each game deducts credits based on actual
            generation cost. Buy more credits anytime to keep building.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Do I own the game?</summary>
          <p class="faq-answer">
            Yes, 100%. The generated game and all its assets are yours. You can
            sell it, modify it, open-source it, or do anything you want with it.
            No royalties, no attribution required.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What engine does it use?</summary>
          <p class="faq-answer">
            All games are built with <span style="color: #4582c7;">Godot 4</span>, an open-source game engine. You get
            the full project files so you can open them in the <span style="color: #4582c7;">Godot</span> editor and
            continue development.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How long does generation take?</summary>
          <p class="faq-answer">
            Typically 15-30 minutes depending on complexity. You will receive an
            email when your game is ready to download.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section bottom-cta">
    <div class="container">
      <div class="section-header">
        <h2>Ready to <span class="gradient-text">Build</span>?</h2>
        <p>Your first game is free. Describe your idea and have a playable build in minutes.</p>
        <a href="/create" class="btn btn-primary btn-lg cta-btn">Create Your Free Game</a>
      </div>
    </div>
  </section>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "CircuitBot AI Game Generator",
    "description": "AI-powered service that generates complete, playable Godot 4 games from text descriptions. Includes art assets, game code, and compiled executable.",
    "brand": { "@type": "Brand", "name": "CircuitBot" },
    "offers": [
      {
        "@type": "Offer",
        "name": "Free Trial",
        "price": "0",
        "priceCurrency": "USD",
        "description": "One free AI-generated game with phone verification",
        "availability": "https://schema.org/InStock"
      },
      {
        "@type": "Offer",
        "name": "Per Game",
        "price": "6.99",
        "priceCurrency": "USD",
        "description": "One fully generated Godot 4 game with art, code, and executable",
        "availability": "https://schema.org/InStock"
      }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is the first game really free?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, completely free. Create an account, verify your phone number, and generate one full game at no cost. No credit card needed. Same quality and features as paid games." }
      },
      {
        "@type": "Question",
        "name": "Is it a subscription?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. After your free game, you pay once per game. There are no recurring charges, no monthly fees, and no hidden costs. Each additional game is a one-time purchase of $6.99." }
      },
      {
        "@type": "Question",
        "name": "Can I get a refund?",
        "acceptedAnswer": { "@type": "Answer", "text": "If generation fails or produces something fundamentally broken, yes. Contact us and we will make it right." }
      },
      {
        "@type": "Question",
        "name": "Do I own the game?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, 100%. The generated game and all its assets are yours. You can sell it, modify it, open-source it, or do anything you want with it. No royalties, no attribution required." }
      },
      {
        "@type": "Question",
        "name": "What engine does it use?",
        "acceptedAnswer": { "@type": "Answer", "text": "All games are built with Godot 4, an open-source game engine. You get the full project files so you can open them in the Godot editor and continue development." }
      },
      {
        "@type": "Question",
        "name": "How long does generation take?",
        "acceptedAnswer": { "@type": "Answer", "text": "Typically 15-30 minutes depending on complexity. You will receive an email when your game is ready to download." }
      },
      {
        "@type": "Question",
        "name": "How many games can I create?",
        "acceptedAnswer": { "@type": "Answer", "text": "As many as you want. Each game costs $6.99 to generate. There are no limits on how many games you can create." }
      }
    ]
  })} />

</Layout>

<style>
  /* ── Hero ────────────────────────── */
  .pricing-hero {
    position: relative;
    padding-bottom: 40px;
  }

  .pricing-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 0 30px rgba(69, 130, 199, 0.2);
    margin-bottom: 12px;
  }

  .pricing-subtitle-text {
    font-size: 18px;
    color: var(--text-secondary);
  }

  /* ── Pricing Cards ──────────────── */
  .pricing-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
  }

  .pricing-card-grid-4 {
    grid-template-columns: repeat(4, 1fr);
    max-width: 1100px;
  }

  .pricing-card-popular {
    border-color: var(--accent-yellow);
    box-shadow: 0 0 30px rgba(255, 211, 64, 0.08);
  }

  .credits-explainer {
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 24px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 48px 40px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .pricing-card-free {
    border-color: var(--accent-yellow);
    box-shadow: 0 0 30px rgba(255, 211, 64, 0.08);
  }

  .pricing-card-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 120px;
    background: radial-gradient(ellipse, rgba(69, 130, 199, 0.12), transparent 70%);
    pointer-events: none;
  }

  .pricing-card-glow-yellow {
    background: radial-gradient(ellipse, rgba(255, 211, 64, 0.12), transparent 70%);
  }

  .pricing-card-header {
    position: relative;
  }

  .pricing-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin: 20px 0 4px;
  }

  .pricing-dollar {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--text-muted);
  }

  .pricing-value {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 700;
    color: var(--accent-yellow);
    line-height: 1;
  }

  .pricing-value-yellow {
    color: var(--accent-yellow);
  }

  .pricing-dollar-yellow {
    color: var(--accent-yellow);
  }

  .feature-check-yellow {
    color: var(--accent-yellow);
    text-shadow: 0 0 6px rgba(255, 211, 64, 0.4);
  }

  .pricing-label {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .pricing-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-light), transparent);
    margin: 28px 0;
  }

  .pricing-includes {
    text-align: left;
  }

  .pricing-includes-label {
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .pricing-features {
    list-style: none;
  }

  .pricing-features li {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-secondary);
    padding: 6px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .feature-check {
    color: var(--accent-blue);
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
    text-shadow: 0 0 6px rgba(69, 130, 199, 0.4);
  }

  .pricing-cta {
    width: 100%;
    justify-content: center;
    margin-top: 28px;
    font-size: 15px;
  }

  .pricing-note {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  /* ── Included Cards ─────────────── */
  .included-card {
    text-align: center;
    padding: 32px 24px;
  }

  .included-icon {
    font-size: 32px;
    margin-bottom: 16px;
    filter: grayscale(0.3);
  }

  .included-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    color: var(--text-primary);
  }

  .included-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── FAQ ─────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq-item[open] {
    border-color: var(--border-light);
  }

  .faq-question {
    padding: 18px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.2s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 18px;
    color: var(--accent-blue);
    font-weight: 400;
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-question::after {
    content: '-';
  }

  .faq-question:hover {
    color: var(--accent-blue);
  }

  .faq-answer {
    padding: 0 24px 18px;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin: 0 16px;
  }

  /* ── Bottom CTA ─────────────────── */
  .bottom-cta {
    padding-bottom: 80px;
  }

  .cta-btn {
    margin-top: 24px;
  }

  /* ── Responsive ─────────────────── */
  @media (max-width: 900px) {
    .pricing-card-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .pricing-card-grid,
    .pricing-card-grid-4 {
      grid-template-columns: 1fr;
    }

    .pricing-card {
      padding: 32px 24px;
    }

    .pricing-value {
      font-size: 48px;
    }

    .faq-question {
      padding: 14px 18px;
      font-size: 13px;
    }

    .faq-answer {
      padding: 0 18px 14px;
      margin: 0 10px;
    }
  }
</style>

<script is:inline>
  (function() {
    var API_BASE = window.location.hostname === 'localhost'
      ? 'http://localhost:8000'
      : 'https://circuitbot-api-production.up.railway.app';

    document.querySelectorAll('[data-pack]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var token = localStorage.getItem('token');
        if (!token) {
          window.location.href = '/login?redirect=/pricing';
          return;
        }
        var pack = btn.dataset.pack;
        btn.textContent = 'Loading...';
        btn.disabled = true;

        fetch(API_BASE + '/api/billing/credits/purchase', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ pack_id: pack }),
        })
        .then(function(r) {
          if (!r.ok) throw new Error('Failed');
          return r.json();
        })
        .then(function(data) {
          if (data.checkout_url) {
            window.location.href = data.checkout_url;
          }
        })
        .catch(function(err) {
          alert('Could not start checkout. Please try again.');
          btn.textContent = 'Buy Credits';
          btn.disabled = false;
        });
      });
    });
  })();
</script>
