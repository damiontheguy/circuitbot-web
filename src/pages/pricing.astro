<script>
  const loopsSlider = document.getElementById('loops-per-day') as HTMLInputElement;
  const opusSlider = document.getElementById('opus-percent') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-model-mix') as HTMLButtonElement;
  const loopsDisplay = document.getElementById('loops-display')!;
  const opusDisplay = document.getElementById('opus-display')!;
  const mixLabel = document.getElementById('mix-label')!;
  const opusControl = document.getElementById('opus-control')!;

  const calcTotal = document.getElementById('calc-total')!;
  const sonnetCostEl = document.getElementById('sonnet-cost')!;
  const opusCostEl = document.getElementById('opus-cost')!;
  const haikuCostEl = document.getElementById('haiku-cost')!;
  const opusCostLine = document.getElementById('opus-cost-line')!;
  const totalValueEl = document.getElementById('total-value')!;
  const detailLoops = document.getElementById('detail-loops')!;
  const detailModel = document.getElementById('detail-model')!;

  const PLATFORM_FEE = 29;
  const SONNET_PER_LOOP = 0.70;
  const OPUS_PER_LOOP = 4.00;
  const HAIKU_PER_LOOP = 0.02;
  const DAYS_PER_MONTH = 30;

  let modelMixEnabled = true;

  function fmt(n: number): string {
    return '$' + n.toFixed(2);
  }

  function calculate(): void {
    const loopsPerDay = parseInt(loopsSlider.value, 10);
    const opusPct = modelMixEnabled ? parseInt(opusSlider.value, 10) / 100 : 0;
    const totalLoops = loopsPerDay * DAYS_PER_MONTH;

    const opusLoops = Math.round(totalLoops * opusPct);
    const sonnetLoops = totalLoops - opusLoops;

    const sonnetCost = sonnetLoops * SONNET_PER_LOOP;
    const opusCost = opusLoops * OPUS_PER_LOOP;
    const haikuCost = totalLoops * HAIKU_PER_LOOP;

    const usageCost = sonnetCost + opusCost + haikuCost;
    const total = PLATFORM_FEE + usageCost;

    loopsDisplay.textContent = String(loopsPerDay);
    opusDisplay.textContent = (opusPct * 100).toFixed(0) + '%';

    calcTotal.textContent = fmt(total);
    sonnetCostEl.textContent = fmt(sonnetCost);
    opusCostEl.textContent = fmt(opusCost);
    haikuCostEl.textContent = fmt(haikuCost);
    totalValueEl.textContent = fmt(total);

    detailLoops.textContent = totalLoops + ' tasks/mo (' + loopsPerDay + '/day x ' + DAYS_PER_MONTH + ' days)';

    if (modelMixEnabled && opusPct > 0) {
      detailModel.textContent = sonnetLoops + ' Standard + ' + opusLoops + ' Advanced + ' + totalLoops + ' Lite triage';
    } else {
      detailModel.textContent = sonnetLoops + ' Standard + ' + totalLoops + ' Lite triage';
    }

    opusCostLine.style.display = (modelMixEnabled && opusPct > 0) ? 'flex' : 'none';
  }

  loopsSlider.addEventListener('input', calculate);
  opusSlider.addEventListener('input', calculate);

  toggleBtn.addEventListener('click', function () {
    modelMixEnabled = !modelMixEnabled;
    toggleBtn.setAttribute('aria-pressed', String(modelMixEnabled));
    mixLabel.textContent = modelMixEnabled ? 'ON' : 'OFF';

    if (modelMixEnabled) {
      opusControl.classList.remove('hidden');
    } else {
      opusControl.classList.add('hidden');
    }

    calculate();
  });

  calculate();
</script>
