---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pricing — CircuitBot" description="One price. One game. No subscriptions. $14.99 per game, fully generated.">

  <!-- Hero -->
  <section class="section pricing-hero">
    <div class="container">
      <div class="bg-grid"></div>
      <div class="section-header">
        <span class="badge badge-green">Pricing</span>
        <h1 class="pricing-title">Simple <span class="gradient-text">Pricing</span></h1>
        <p class="pricing-subtitle-text">One price. One game. No subscriptions.</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- Pricing Card -->
  <section class="section">
    <div class="container">
      <div class="pricing-card-wrapper">
        <div class="pricing-card">
          <div class="pricing-card-glow"></div>
          <div class="pricing-card-header">
            <span class="badge badge-cyan">Pay Per Game</span>
            <div class="pricing-amount">
              <span class="pricing-dollar">$</span>
              <span class="pricing-value">14.99</span>
            </div>
            <p class="pricing-label">per game</p>
          </div>

          <div class="pricing-divider"></div>

          <div class="pricing-includes">
            <p class="pricing-includes-label">// everything included</p>
            <ul class="pricing-features">
              <li><span class="feature-check">&#10003;</span> Complete Godot 4 project</li>
              <li><span class="feature-check">&#10003;</span> AI-generated 2D &amp; 3D art</li>
              <li><span class="feature-check">&#10003;</span> Full GDScript game code</li>
              <li><span class="feature-check">&#10003;</span> Compiled Windows executable</li>
              <li><span class="feature-check">&#10003;</span> Delivered in ~15-30 minutes</li>
              <li><span class="feature-check">&#10003;</span> Source code included — edit freely</li>
            </ul>
          </div>

          <a href="/create" class="btn btn-primary btn-lg pricing-cta">Create Your Game</a>
          <p class="pricing-note">No account needed until you generate</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- What's Included -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-green">Deliverables</span>
        <h2>What's <span class="gradient-text">Included</span></h2>
        <p>Every generated game ships with these three pillars.</p>
      </div>

      <div class="grid grid-3">
        <div class="card included-card">
          <div class="included-icon">&#127912;</div>
          <h3 class="included-title">AI Art Generation</h3>
          <p class="included-desc">
            Sprites, textures, tilesets, and backgrounds — all generated to match
            your game's style. No placeholder art.
          </p>
        </div>
        <div class="card included-card">
          <div class="included-icon">&#9000;</div>
          <h3 class="included-title">Game Logic</h3>
          <p class="included-desc">
            Complete GDScript code for all mechanics you described — movement,
            combat, UI, menus, scoring, and game state.
          </p>
        </div>
        <div class="card included-card">
          <div class="included-icon">&#9654;</div>
          <h3 class="included-title">Compiled Build</h3>
          <p class="included-desc">
            A Windows .exe ready to play, plus the full Godot project so you can
            open it in the editor and keep building.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- FAQ -->
  <section class="section">
    <div class="container-narrow">
      <div class="section-header">
        <span class="badge badge-cyan">FAQ</span>
        <h2>Common <span class="gradient-text">Questions</span></h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">Is it a subscription?</summary>
          <p class="faq-answer">
            No. You pay once per game. There are no recurring charges, no monthly
            fees, and no hidden costs. Each game generation is a one-time purchase
            of $14.99.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Can I get a refund?</summary>
          <p class="faq-answer">
            If generation fails or produces something fundamentally broken, yes.
            Contact us and we'll make it right. We stand behind the quality of
            every generated game.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How many games can I create?</summary>
          <p class="faq-answer">
            As many as you want. Each game costs $14.99 to generate. There are no
            limits on how many games you can create.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Do I own the game?</summary>
          <p class="faq-answer">
            Yes, 100%. The generated game and all its assets are yours. You can
            sell it, modify it, open-source it, or do anything you want with it.
            No royalties, no attribution required.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What engine does it use?</summary>
          <p class="faq-answer">
            All games are built with Godot 4, an open-source game engine. You get
            the full project files so you can open them in the Godot editor and
            continue development.
          </p>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How long does generation take?</summary>
          <p class="faq-answer">
            Typically 15-30 minutes depending on complexity. You'll receive an
            email when your game is ready to download.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section bottom-cta">
    <div class="container">
      <div class="section-header">
        <h2>Ready to <span class="gradient-text">Build</span>?</h2>
        <p>Describe your game idea and have a playable build in minutes.</p>
        <a href="/create" class="btn btn-primary btn-lg cta-btn">Create Your Game — $14.99</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ────────────────────────── */
  .pricing-hero {
    position: relative;
    padding-bottom: 40px;
  }

  .pricing-title {
    font-family: var(--font-mono);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 0 30px rgba(46, 204, 94, 0.2);
    margin-bottom: 12px;
  }

  .pricing-subtitle-text {
    font-size: 18px;
    color: var(--text-secondary);
  }

  /* ── Pricing Card ───────────────── */
  .pricing-card-wrapper {
    display: flex;
    justify-content: center;
  }

  .pricing-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 48px 40px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .pricing-card-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 120px;
    background: radial-gradient(ellipse, rgba(46, 204, 94, 0.12), transparent 70%);
    pointer-events: none;
  }

  .pricing-card-header {
    position: relative;
  }

  .pricing-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
    margin: 20px 0 4px;
  }

  .pricing-dollar {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--text-muted);
  }

  .pricing-value {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .pricing-label {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .pricing-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-light), transparent);
    margin: 28px 0;
  }

  .pricing-includes {
    text-align: left;
  }

  .pricing-includes-label {
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 12px;
    letter-spacing: 0.5px;
  }

  .pricing-features {
    list-style: none;
  }

  .pricing-features li {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-secondary);
    padding: 6px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .feature-check {
    color: var(--accent-green);
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
    text-shadow: 0 0 6px rgba(46, 204, 94, 0.4);
  }

  .pricing-cta {
    width: 100%;
    justify-content: center;
    margin-top: 28px;
    font-size: 15px;
  }

  .pricing-note {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  /* ── Included Cards ─────────────── */
  .included-card {
    text-align: center;
    padding: 32px 24px;
  }

  .included-icon {
    font-size: 32px;
    margin-bottom: 16px;
    filter: grayscale(0.3);
  }

  .included-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    color: var(--text-primary);
  }

  .included-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── FAQ ─────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq-item[open] {
    border-color: var(--border-light);
  }

  .faq-question {
    padding: 18px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.2s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 18px;
    color: var(--accent-green);
    font-weight: 400;
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-question::after {
    content: '-';
  }

  .faq-question:hover {
    color: var(--accent-green);
  }

  .faq-answer {
    padding: 0 24px 18px;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin: 0 16px;
  }

  /* ── Bottom CTA ─────────────────── */
  .bottom-cta {
    padding-bottom: 80px;
  }

  .cta-btn {
    margin-top: 24px;
  }

  /* ── Responsive ─────────────────── */
  @media (max-width: 600px) {
    .pricing-card {
      padding: 32px 24px;
    }

    .pricing-value {
      font-size: 48px;
    }

    .faq-question {
      padding: 14px 18px;
      font-size: 13px;
    }

    .faq-answer {
      padding: 0 18px 14px;
      margin: 0 10px;
    }
  }
</style>
