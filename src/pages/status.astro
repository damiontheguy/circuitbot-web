---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Game Status — CircuitBot" description="Track the progress of your AI-generated game. View real-time build status and download when complete." noindex={true}>

  <section class="section status-section">
    <div class="container container-narrow">
      <div class="section-header">
        <h1 class="gradient-text">Game Status</h1>
      </div>

      <div id="status-container">
        <!-- Loading -->
        <div id="status-loading" class="state-msg">
          <div class="loader-ring"></div>
          <p>Fetching job status...</p>
        </div>

        <!-- Error -->
        <div id="status-error" class="state-msg" style="display:none;">
          <div class="state-icon" style="color:var(--accent-red);">&#9888;</div>
          <h2>Could not load status</h2>
          <p id="status-error-msg"></p>
          <button class="btn btn-primary" onclick="loadStatus()">Retry</button>
        </div>

        <!-- In-progress -->
        <div id="status-progress" class="status-card" style="display:none;">
          <div class="prompt-block">
            <span class="prompt-label">Your prompt</span>
            <p id="prog-prompt" class="prompt-text"></p>
          </div>

          <div class="progress-wrapper">
            <div class="progress-track">
              <div id="prog-bar" class="progress-fill"></div>
              <div class="progress-scan"></div>
            </div>
            <div class="progress-meta">
              <span id="prog-pct" class="progress-pct">0%</span>
              <span id="prog-stage" class="progress-stage"></span>
            </div>
          </div>

          <div class="terminal-log">
            <div class="terminal-log-bar">
              <span class="terminal-dot red"></span>
              <span class="terminal-dot yellow"></span>
              <span class="terminal-dot green"></span>
              <span class="terminal-log-title">pipeline</span>
            </div>
            <div id="prog-log" class="terminal-log-body"></div>
          </div>

          <div id="prog-working" class="working-indicator">
            <span class="working-dot"></span>
            <span class="working-dot d2"></span>
            <span class="working-dot d3"></span>
            <span>Working</span>
            <span id="elapsed-timer" class="elapsed-timer"></span>
          </div>
        </div>

        <!-- Completed -->
        <div id="status-complete" class="status-card" style="display:none;">
          <div class="complete-heading">
            <span class="complete-check">&#10003;</span>
            <h2 class="complete-title">Your game is ready!</h2>
          </div>
          <p id="comp-prompt" class="prompt-text" style="margin-bottom:1rem;"></p>
          <p id="comp-size" class="file-size"></p>
          <a id="comp-download" href="#" class="btn btn-yellow btn-lg download-btn" onclick="onDownloadClick(event)">Download Your Game</a>

          <!-- Learning guide container — appears when download starts -->
          <div id="learn-container" class="learn-container" style="display:none;">
            <div class="learn-header">
              <span class="learn-icon">&#128218;</span>
              <div>
                <h3 class="learn-title">How Your Game Works</h3>
                <p class="learn-subtitle">A beginner-friendly breakdown of every script and mechanic</p>
              </div>
            </div>
            <div class="learn-loading" id="learn-loading">
              <div class="loader-ring"></div>
              <p>Loading your personalized learning guide...</p>
            </div>
            <iframe id="learn-frame" class="learn-frame" style="display:none;" sandbox="allow-same-origin"></iframe>
          </div>

          <div class="your-turn-block">
            <img src="/circuitbot.png" alt="CircuitBot" class="your-turn-mini-mascot" />
            <h3 class="your-turn-mini-title">Learn Godot By Building</h3>
            <p class="your-turn-mini-text">
              This is a real <span style="color: #4582c7;">Godot 4</span> project with a personalized guide that explains
              every line of code. Open it up, read the guide, change things — that is how you learn game dev.
            </p>
            <div class="your-turn-mini-links">
              <a href="https://godotengine.org/download/" target="_blank" rel="noopener" class="btn btn-primary">Get Godot Engine</a>
              <a href="https://docs.godotengine.org/en/stable/getting_started/introduction/index.html" target="_blank" rel="noopener" class="btn">Learn Godot</a>
            </div>
          </div>

          <!-- Edit / Request Changes (admin only) -->
          <div id="edit-section" class="edit-section" style="display:none;">
            <div class="edit-header">
              <span class="edit-icon">&#9998;</span>
              <div>
                <h3 class="edit-title">Request Changes</h3>
                <p class="edit-subtitle">Describe bugs, improvements, or changes you want applied</p>
              </div>
            </div>
            <textarea id="edit-instructions" class="edit-textarea" rows="5" placeholder="e.g. The player can walk through walls. Also make the jump higher and add a score counter in the top-right corner."></textarea>
            <button id="edit-submit" class="btn btn-primary edit-submit" onclick="submitEdit()">Apply Changes</button>
            <p id="edit-error" class="edit-error" style="display:none;"></p>
          </div>

          <a href="/create" class="btn create-another">Create Another Game</a>
        </div>

        <!-- Failed -->
        <div id="status-failed" class="status-card" style="display:none;">
          <div class="failed-heading">
            <span class="failed-x">&#10007;</span>
            <h2 class="failed-title">Generation Failed</h2>
          </div>
          <p id="fail-prompt" class="prompt-text" style="margin-bottom:0.75rem;"></p>
          <div id="fail-error" class="fail-error-box"></div>
          <a id="fail-retry" href="/create" class="btn btn-primary">Try Again</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .status-section {
    min-height: 75vh;
    padding-top: 3rem;
  }

  /* ---------- Shared states ---------- */
  .state-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 4rem 1rem;
    text-align: center;
    color: var(--text-muted, #888);
  }

  .state-icon { font-size: 2.5rem; line-height: 1; }

  .state-msg h2 {
    color: var(--text-primary, #eee);
    margin: 0;
  }

  .loader-ring {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border, #333);
    border-top-color: var(--accent-blue);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ---------- Status card shell ---------- */
  .status-card {
    background: var(--bg-card, #2c2e2d);
    border: 1px solid var(--border, #353738);
    border-radius: 14px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ---------- Prompt block ---------- */
  .prompt-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted, #666);
    font-family: var(--font-mono);
  }

  .prompt-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-primary, #e0e0e0);
    line-height: 1.6;
    margin: 0.35rem 0 0;
  }

  /* ---------- Progress bar ---------- */
  .progress-wrapper { display: flex; flex-direction: column; gap: 0.6rem; }

  .progress-track {
    position: relative;
    width: 100%;
    height: 22px;
    background: var(--bg-secondary, #202125);
    border: 1px solid var(--border, #353738);
    border-radius: 6px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-blue), #5ea8e0, var(--accent-yellow));
    border-radius: 5px;
    transition: width 0.6s ease;
    position: relative;
    z-index: 1;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 1; filter: brightness(1); }
    50% { opacity: 0.85; filter: brightness(1.3); }
  }

  /* Scanning line effect */
  .progress-scan {
    position: absolute;
    top: 0;
    left: -40%;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(69, 130, 199, 0.25), transparent);
    z-index: 2;
    animation: scan 2s ease-in-out infinite;
  }

  @keyframes scan {
    0%   { left: -40%; }
    100% { left: 100%; }
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .progress-pct {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .progress-stage {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted, #888);
  }

  /* ---------- Terminal log ---------- */
  .terminal-log {
    border: 1px solid var(--border, #353738);
    border-radius: 10px;
    overflow: hidden;
    background: #181a1c;
  }

  .terminal-log-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border, #353738);
  }

  .terminal-dot {
    width: 10px; height: 10px; border-radius: 50%;
  }
  .terminal-dot.red    { background: #ff5f57; }
  .terminal-dot.yellow { background: #febc2e; }
  .terminal-dot.green  { background: #4582c7; }

  .terminal-log-title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted, #666);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .terminal-log-body {
    padding: 0.75rem 1rem;
    font-family: var(--font-code, var(--font-mono));
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text-muted, #888);
    min-height: 100px;
    max-height: 220px;
    overflow-y: auto;
  }

  .log-line {
    opacity: 0;
    animation: fadeIn 0.4s forwards;
  }

  .log-line.done { color: var(--accent-blue); }
  .log-line.active { color: var(--accent-yellow); }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  /* ---------- Working indicator ---------- */
  .working-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted, #888);
    justify-content: center;
  }

  .working-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent-blue);
    animation: bounce 1.2s ease-in-out infinite;
  }
  .working-dot.d2 { animation-delay: 0.15s; }
  .working-dot.d3 { animation-delay: 0.3s; }

  .elapsed-timer {
    margin-left: 0.5rem;
    color: var(--text-muted, #666);
    font-variant-numeric: tabular-nums;
  }

  @keyframes bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40%           { transform: translateY(-6px); opacity: 1; }
  }

  /* ---------- Completed ---------- */
  .complete-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .complete-check {
    font-size: 2rem;
    color: var(--accent-yellow);
    line-height: 1;
  }

  .complete-title {
    margin: 0;
    color: var(--text-primary);
  }

  .file-size {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted, #888);
    margin: 0;
  }

  .download-btn {
    text-align: center;
    text-decoration: none;
  }

  .create-another {
    text-align: center;
    text-decoration: none;
    color: var(--text-muted, #888);
  }
  .create-another:hover { color: var(--accent-yellow); }

  /* ---------- Learning Guide ---------- */
  .learn-container {
    border: 1px solid var(--accent-blue);
    border-radius: 12px;
    overflow: hidden;
    background: #181a1c;
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .learn-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: rgba(69, 130, 199, 0.08);
    border-bottom: 1px solid var(--border);
  }

  .learn-icon { font-size: 1.5rem; }

  .learn-title {
    margin: 0;
    font-size: 1rem;
    color: var(--accent-blue);
  }

  .learn-subtitle {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .learn-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .learn-frame {
    width: 100%;
    min-height: 600px;
    border: none;
    background: #1a1a2e;
  }

  /* ---------- Your Turn block ---------- */
  .your-turn-block {
    text-align: center;
    padding: 28px 24px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }

  .your-turn-block::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-yellow), #ff9f43, var(--accent-yellow));
  }

  .your-turn-mini-mascot {
    width: 48px;
    height: 48px;
    object-fit: contain;
    margin: 0 auto 12px;
  }

  .your-turn-mini-title {
    font-family: var(--font-display, inherit);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent-yellow);
    margin-bottom: 8px;
  }

  .your-turn-mini-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    max-width: 420px;
    margin: 0 auto 18px;
    line-height: 1.6;
  }

  .your-turn-mini-links {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ---------- Edit Section ---------- */
  .edit-section {
    border: 1px solid var(--border, #353738);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-secondary, #202125);
  }

  .edit-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: rgba(69, 130, 199, 0.06);
    border-bottom: 1px solid var(--border);
  }

  .edit-icon { font-size: 1.4rem; color: var(--accent-blue); }

  .edit-title {
    margin: 0;
    font-size: 1rem;
    color: var(--accent-blue);
  }

  .edit-subtitle {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .edit-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 20px;
    background: var(--bg-card, #2c2e2d);
    border: none;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary, #e0e0e0);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    resize: vertical;
    min-height: 100px;
  }

  .edit-textarea::placeholder { color: var(--text-muted, #555); }
  .edit-textarea:focus { outline: none; border-color: var(--accent-blue); }

  .edit-submit {
    margin: 14px 20px;
    width: calc(100% - 40px);
  }

  .edit-error {
    margin: 0 20px 14px;
    font-size: 0.8rem;
    color: var(--accent-red, #ff5f57);
    font-family: var(--font-mono);
  }

  /* ---------- Failed ---------- */
  .failed-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .failed-x {
    font-size: 2rem;
    color: var(--accent-red);
    line-height: 1;
  }

  .failed-title {
    margin: 0;
    color: var(--accent-red);
  }

  .fail-error-box {
    background: rgba(255, 70, 70, 0.08);
    border: 1px solid rgba(255, 70, 70, 0.25);
    border-radius: 8px;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #ff9a9a;
    line-height: 1.6;
  }
</style>

<script>
  const API_BASE = window.location.hostname === 'localhost'
    ? 'http://localhost:8000'
    : 'https://circuitbot-api-production.up.railway.app';

  let pollTimer: ReturnType<typeof setInterval> | null = null;
  let elapsedTimer: ReturnType<typeof setInterval> | null = null;
  let jobStartTime: number | null = null;
  let firstLoad = true;
  let isAdmin = false;
  let currentJobId: string | null = null;

  // ── Helpers ─────────────────────────────────
  function getToken(): string | null {
    return localStorage.getItem('token');
  }

  function requireAuth(): string {
    const token = getToken();
    if (!token) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
      throw new Error('Not authenticated');
    }
    return token;
  }

  function getJobId(): string | null {
    return new URLSearchParams(window.location.search).get('id');
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  // ── Pipeline stage labels ───────────────────
  const STAGE_LABELS: Record<string, string> = {
    planning:   'Planning your game...',
    art:        'Generating art assets...',
    logic:      'Implementing game logic...',
    exporting:  'Exporting executable...',
  };

  interface GameJob {
    id: string;
    prompt: string;
    status: string;
    progress_pct: number;
    progress_message?: string;
    error_message?: string;
    artifact_size_bytes?: number;
    created_at: string;
  }

  // ── Visibility toggles ─────────────────────
  function showOnly(id: string): void {
    ['status-loading', 'status-error', 'status-progress', 'status-complete', 'status-failed']
      .forEach(s => {
        const el = document.getElementById(s);
        if (el) el.style.display = s === id ? (s === 'status-loading' || s === 'status-error' ? 'flex' : 'flex') : 'none';
      });
  }

  // ── Elapsed timer ───────────────────────────
  function startElapsedTimer(startedAt?: string): void {
    if (!jobStartTime) {
      jobStartTime = startedAt ? new Date(startedAt).getTime() : Date.now();
    }
    if (elapsedTimer) return;
    const timerEl = document.getElementById('elapsed-timer');
    elapsedTimer = setInterval(() => {
      if (!timerEl || !jobStartTime) return;
      const sec = Math.floor((Date.now() - jobStartTime) / 1000);
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      timerEl.textContent = m > 0 ? `${m}m ${s.toString().padStart(2, '0')}s` : `${s}s`;
    }, 1000);
  }

  function stopElapsedTimer(): void {
    if (elapsedTimer) { clearInterval(elapsedTimer); elapsedTimer = null; }
  }

  // ── Render: In-progress ─────────────────────
  function renderProgress(job: GameJob): void {
    showOnly('status-progress');

    document.getElementById('prog-prompt')!.textContent = job.prompt;

    const pct = job.progress_pct ?? 0;
    document.getElementById('prog-bar')!.style.width = pct + '%';
    document.getElementById('prog-pct')!.textContent = pct + '%';

    const msg = job.progress_message ?? '';
    document.getElementById('prog-stage')!.textContent = msg;

    startElapsedTimer((job as any).started_at);

    // Build log lines from progress message
    const logEl = document.getElementById('prog-log')!;
    if (msg) {
      const line = document.createElement('div');
      line.className = 'log-line active';
      line.textContent = '\u25B6 ' + msg;
      // Only append if not duplicate of last line
      const lastLine = logEl.lastElementChild;
      if (!lastLine || lastLine.textContent !== line.textContent) {
        logEl.appendChild(line);
        logEl.scrollTop = logEl.scrollHeight;
      }
    }

    startPolling();
  }

  // ── Render: Completed ───────────────────────
  async function renderComplete(job: GameJob): Promise<void> {
    showOnly('status-complete');
    stopPolling();
    currentJobId = job.id;

    document.getElementById('comp-prompt')!.textContent = job.prompt;

    if (job.artifact_size_bytes) {
      document.getElementById('comp-size')!.textContent = 'File size: ' + formatBytes(job.artifact_size_bytes);
    }

    // Fetch presigned download URL
    const token = getToken();
    try {
      const res = await fetch(`${API_BASE}/api/games/${job.id}/download`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const data = await res.json();
        (document.getElementById('comp-download') as HTMLAnchorElement).href = data.download_url;
      }
    } catch { /* download link will remain # */ }

    // Check admin status — show edit section if admin
    try {
      const statusRes = await fetch(`${API_BASE}/api/auth/phone/status`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (statusRes.ok) {
        const statusData = await statusRes.json();
        isAdmin = statusData.is_admin;
        if (isAdmin) {
          document.getElementById('edit-section')!.style.display = 'block';
        }
      }
    } catch { /* non-critical */ }
  }

  async function submitEdit(): Promise<void> {
    const token = getToken();
    if (!token || !currentJobId) return;

    const textarea = document.getElementById('edit-instructions') as HTMLTextAreaElement;
    const btn = document.getElementById('edit-submit') as HTMLButtonElement;
    const errEl = document.getElementById('edit-error')!;
    const instructions = textarea.value.trim();

    if (!instructions || instructions.length < 5) {
      errEl.textContent = 'Please describe your changes (at least 5 characters).';
      errEl.style.display = 'block';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Submitting...';
    errEl.style.display = 'none';

    try {
      const res = await fetch(`${API_BASE}/api/games/${currentJobId}/edit`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ instructions }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({ detail: 'Request failed' }));
        throw new Error(data.detail || `Server returned ${res.status}`);
      }

      const editJob = await res.json();
      // Redirect to the new edit job's status page
      window.location.href = `/status?id=${editJob.id}`;
    } catch (err: any) {
      errEl.textContent = err.message || 'Failed to submit changes.';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Apply Changes';
    }
  }

  // ── Render: Failed ──────────────────────────
  function renderFailed(job: GameJob): void {
    showOnly('status-failed');
    stopPolling();

    document.getElementById('fail-prompt')!.textContent = job.prompt;
    document.getElementById('fail-error')!.textContent = job.error_message ?? 'An unknown error occurred during generation.';

    const retryLink = document.getElementById('fail-retry') as HTMLAnchorElement;
    retryLink.href = '/create?prompt=' + encodeURIComponent(job.prompt);
  }

  // ── Fetch & dispatch ────────────────────────
  async function loadStatus(): Promise<void> {
    const token = requireAuth();
    const jobId = getJobId();

    if (!jobId) {
      showOnly('status-error');
      document.getElementById('status-error-msg')!.textContent = 'No job ID provided. Go to My Games to see your jobs.';
      return;
    }

    if (firstLoad) showOnly('status-loading');

    try {
      const res = await fetch(`${API_BASE}/api/games/${jobId}`, {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (!res.ok) {
        if (res.status === 401) {
          localStorage.removeItem('token');
          window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
          return;
        }
        if (res.status === 404) throw new Error('Job not found. It may have been deleted.');
        throw new Error(`Server returned ${res.status}`);
      }

      const job: GameJob = await res.json();
      firstLoad = false;

      switch (job.status) {
        case 'completed':
          await renderComplete(job);
          break;
        case 'failed':
          renderFailed(job);
          break;
        default:
          renderProgress(job);
          break;
      }
    } catch (err: any) {
      if (firstLoad) {
        showOnly('status-error');
        document.getElementById('status-error-msg')!.textContent = err.message || 'Failed to load status.';
        stopPolling();
      }
      // During polling, silently skip — next tick will retry
    }
  }

  // ── Polling ─────────────────────────────────
  function startPolling(): void {
    if (pollTimer) return;
    pollTimer = setInterval(loadStatus, 3_000);
  }

  function stopPolling(): void {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    stopElapsedTimer();
  }

  // ── Download + Learning Guide ───────────────
  async function onDownloadClick(e: Event): Promise<void> {
    // Let the download proceed normally (href is already set)
    // Then show the learning guide
    const jobId = getJobId();
    const token = getToken();
    if (!jobId || !token) return;

    const container = document.getElementById('learn-container')!;
    const loading = document.getElementById('learn-loading')!;
    const frame = document.getElementById('learn-frame') as HTMLIFrameElement;

    container.style.display = 'block';
    loading.style.display = 'flex';
    frame.style.display = 'none';

    // Scroll to the guide
    setTimeout(() => container.scrollIntoView({ behavior: 'smooth', block: 'start' }), 300);

    try {
      const res = await fetch(`${API_BASE}/api/games/${jobId}/learn`, {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (!res.ok) {
        loading.innerHTML = '<p style="color:var(--text-muted);">Learning guide not available for this game.</p>';
        return;
      }

      const data = await res.json();
      // Fetch the HTML content and inject into iframe
      const htmlRes = await fetch(data.learn_url);
      const html = await htmlRes.text();

      loading.style.display = 'none';
      frame.style.display = 'block';
      frame.srcdoc = html;

      // Auto-resize iframe to content
      frame.onload = () => {
        try {
          const h = frame.contentDocument?.documentElement?.scrollHeight;
          if (h) frame.style.minHeight = Math.min(h + 20, 2000) + 'px';
        } catch { /* cross-origin, keep default height */ }
      };
    } catch {
      loading.innerHTML = '<p style="color:var(--text-muted);">Could not load learning guide.</p>';
    }
  }

  // ── Init ────────────────────────────────────
  document.addEventListener('DOMContentLoaded', loadStatus);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopPolling();
    } else {
      loadStatus();
    }
  });
</script>
